{
  "manifest_version": 3,
  "name": "xbrain Web Clipper",
  "version": "1.2.0",
  "description": "Clip web content into your team's xbrain memory + route Claude Pro/Max via session-bridge (Phase 9)",
  "permissions": ["identity", "activeTab", "storage", "alarms", "sidePanel", "clipboardWrite", "contextMenus", "notifications"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    },
    {
      "matches": ["https://chat.grooveos.app/*"],
      "js": ["librechat_autofill.js"],
      "run_at": "document_idle"
    }
  ],
  "oauth2": {
    "client_id": "50097563098-rdh24v05dcp0ees8o4kqviuuoi5sup3n.apps.googleusercontent.com",
    "scopes": ["openid", "email", "profile"]
  },
  "host_permissions": [
    "https://api.grooveos.app/*",
    "https://bridge.grooveos.app/*",
    "https://chat.grooveos.app/*",
    "https://claude.ai/*",
    "https://api.claude.ai/*"
  ]
}
