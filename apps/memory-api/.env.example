# ==========================================================
# memory-api — environment template
# Per-service subset for standalone local dev. The canonical
# template is the repo-root `.env.example`.
# ==========================================================

DATABASE_URL=postgresql+asyncpg://xbrain:CHANGEME@postgres:5432/xbrain
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
GOOGLE_CLIENT_ID=
BRIDGE_SHARED_SECRET=
JWT_ALGORITHM=HS256
LOG_LEVEL=INFO

# OAuth identity — REQUIRED. Settings() fails fast at import/boot if either is
# empty (see app/config.py's field_validator). Use any syntactically valid
# placeholder pair for standalone local dev — these do not need to resolve.
OAUTH_ISSUER_URL=https://api.example.com
OAUTH_RESOURCE_URL=https://mcp.example.com/mcp

# ── Phase 13 — Chat → Brain Ingestion + Retrieval Enrichment ──
# Haiku 4.5 relevance filter — classifies each inbound message before upsert.
# When RELEVANCE_HAIKU_ENABLED=false (or ANTHROPIC_API_KEY is absent), the
# heuristic fallback (≥15 chars) is used instead — ingest still proceeds.
ANTHROPIC_API_KEY=__FILL__
RELEVANCE_HAIKU_ENABLED=true
RELEVANCE_DAILY_TOKEN_CAP_PER_TEAM=50000
RELEVANCE_HAIKU_MODEL=claude-haiku-4-5-20251001
RELEVANCE_HAIKU_TIMEOUT_S=3.0

# ── Phase 19 (EMBED-01) — local keyless embeddings ──
# Default `local`: embeddings run in-container (BAAI/bge-small-en-v1.5, 384-dim), no API key,
# no external call (weights are baked into the image at build). Set `openai` + OPENAI_API_KEY
# to use the 1536-dim OpenAI path instead. Unknown/unset value falls back to local — never crashes.
EMBEDDINGS_PROVIDER=local
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# OSS-light: 1 uvicorn worker so the in-process local model loads once. SaaS parity: 2.
UVICORN_WORKERS=1
