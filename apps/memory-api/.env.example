# ==========================================================
# memory-api — environment template
# Per-service subset for standalone local dev. The canonical
# template is the repo-root `.env.example` (four-section layout:
# [REQUIRED — core boot] / [OPTIONAL — one LLM key] /
# [OPTIONAL — integrations] / [OPTIONAL — saas profile]).
# ==========================================================

# === [REQUIRED — core boot] the vars memory-api fails health without ===
# Postgres DSN — the password MUST match POSTGRES_PASSWORD in the root .env.
DATABASE_URL=postgresql+asyncpg://xbrain:CHANGEME@postgres:5432/xbrain        # [required]
QDRANT_URL=http://qdrant:6333                                                 # [required]
# [optional] leave blank for the bundled unauthenticated Qdrant container
QDRANT_API_KEY=
BRIDGE_SHARED_SECRET=CHANGEME                                                 # [required] HMAC secret for internal service JWTs
JWT_ALGORITHM=HS256                                                           # [required]
LOG_LEVEL=INFO                                                                # [optional]

# OAuth identity — REQUIRED. Settings() fails fast at import/boot if either is
# empty (see app/config.py's field_validator). Use any syntactically valid
# placeholder pair for standalone local dev — these do not need to resolve.
OAUTH_ISSUER_URL=https://api.example.com                                      # [required]
OAUTH_RESOURCE_URL=https://mcp.example.com/mcp                                # [required]
# [required] Fernet key encrypting stored OAuth/media credentials at rest. Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
OAUTH_CREDENTIALS_ENCRYPTION_KEY=__FILL_FERNET_KEY__

# MinIO — backs /v1/media/upload. MINIO_ROOT_PASSWORD MUST be >= 8 chars (the core
# `minio` container crashloops below 8); memory-api's MINIO_SECRET_KEY falls back to it.
MINIO_ENDPOINT=minio:9000                                                     # [optional] internal Docker service name
MINIO_ROOT_USER=minio                                                        # [required]
MINIO_ROOT_PASSWORD=CHANGEME_MIN_8_CHARS                                      # [required] >= 8 chars — MinIO crashloops below 8
MINIO_BUCKET=xbrain-media                                                     # [optional]

# === [OPTIONAL — one LLM key: none needed for the zero-key ingest/retrieve path] ===
# ── Phase 13 — Chat → Brain Ingestion + Retrieval Enrichment ──
# Haiku 4.5 relevance filter — classifies each inbound message before upsert.
# When RELEVANCE_HAIKU_ENABLED=false (or ANTHROPIC_API_KEY is absent), the
# heuristic fallback (≥15 chars) is used instead — ingest still proceeds.
ANTHROPIC_API_KEY=__FILL__                                                    # [optional]
RELEVANCE_HAIKU_ENABLED=true                                                  # [optional]
RELEVANCE_DAILY_TOKEN_CAP_PER_TEAM=50000                                      # [optional]
RELEVANCE_HAIKU_MODEL=claude-haiku-4-5-20251001                              # [optional]
RELEVANCE_HAIKU_TIMEOUT_S=3.0                                                 # [optional]

# ── Phase 19 (EMBED-01) — local keyless embeddings ── [REQUIRED — core boot] ──
# Default `local`: embeddings run in-container (BAAI/bge-small-en-v1.5, 384-dim), no API key,
# no external call (weights are baked into the image at build). Set `openai` + OPENAI_API_KEY
# to use the 1536-dim OpenAI path instead. Unknown/unset value falls back to local — never crashes.
EMBEDDINGS_PROVIDER=local                                                     # [required] local | openai
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5                                  # [optional] baked into the image at build
# OSS-light: 1 uvicorn worker so the in-process local model loads once. SaaS parity: 2.
UVICORN_WORKERS=1                                                             # [required]

# === [OPTIONAL — integrations profile] ===
# [optional] Google OAuth client — Drive/Calendar sidecars, no-op when blank
GOOGLE_CLIENT_ID=
