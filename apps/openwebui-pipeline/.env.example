# ==========================================================
# openwebui-pipeline — environment template
# Copy to .env and fill in values. Never commit .env.
#
# Most values are sourced from the project-root .env.
# This file documents vars specific to the openwebui-pipeline service.
# ==========================================================

# --- Core auth ---
# API key that Open WebUI sends in the Authorization header to the pipeline.
# Generate: openssl rand -hex 16
PIPELINE_API_KEY=__FILL_RANDOM_32_CHARS__

# --- Memory API connection ---
MEMORY_API_URL=http://memory-api:8000
BRIDGE_SHARED_SECRET=__FILL_RANDOM_64_CHARS__
JWT_ALGORITHM=HS256

# --- Default scoping ---
PIPELINE_DEFAULT_TEAM_SCOPE=default

# --- LLM provider keys ---
ANTHROPIC_API_KEY=__FILL__
OPENAI_API_KEY=__FILL__

# ── Phase 13 — Chat → Brain Ingestion + Retrieval Enrichment ──
# Kill-switch for both brain ingest and per-turn enrichment in the pipeline.
# When true, every substantive Open WebUI user message is sent fire-and-forget
# to POST /v1/brain/ingest (Plan 13-06), AND each chat turn is enriched with
# VALIDATED+ facts via GET /v1/system-prompt?min_level=VALIDATED (CHAT-07).
# Set to false to disable both paths without a pipeline restart.
BRAIN_INGEST_ENABLED=true

# Per-turn enrichment config (CHAT-07):
# CHAT07_TOP_K: max number of retrieved facts prepended to the Anthropic system
#   parameter (or OpenAI first system-role message) per turn.
# CHAT07_TRUTH_FILTER_MIN_LEVEL: minimum truth_level for retrieval
#   (VALIDATED includes VALIDATED + CANONICAL + PUBLIC via >= semantics).
CHAT07_TOP_K=5
CHAT07_TRUTH_FILTER_MIN_LEVEL=VALIDATED
