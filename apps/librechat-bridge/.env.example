# ==========================================================
# librechat-bridge — environment template
# Copy to .env and fill in values. Never commit .env.
#
# Most values are sourced from the project-root .env.
# This file documents vars specific to the librechat-bridge service.
# ==========================================================

# --- Core connection vars (shared with project-root .env) ---
MEMORY_API_URL=http://memory-api:8000
BRIDGE_SHARED_SECRET=__FILL_RANDOM_64_CHARS__
JWT_ALGORITHM=HS256

# --- MongoDB (LibreChat replica-set — required for change streams) ---
LIBRECHAT_MONGO_URI=mongodb://librechat-mongo:27017/LibreChat?replicaSet=rs0
BRIDGE_BACKFILL_FROM=startup
BRIDGE_DEFAULT_TEAM_SCOPE=default

# --- Contact extraction (Phase 8) ---
# When CONTACT_EXTRACTION=true, librechat-bridge calls Claude haiku on each
# new message and upserts mentioned persons into /v1/crm/contacts (fail-soft).
CONTACT_EXTRACTION=false
ANTHROPIC_API_KEY=__FILL__
ANTHROPIC_CONTACT_MODEL=claude-3-5-haiku-20241022

# ── Phase 13 — Chat → Brain Ingestion + Retrieval Enrichment ──
# Kill-switch for the brain ingest hook in messages_watch_loop.
# When true, every substantive LibreChat user message is sent fire-and-forget
# to POST /v1/brain/ingest (Plan 13-04). Set to false to disable without restart.
BRAIN_INGEST_ENABLED=true

# Per-turn enrichment (CHAT-07) — injects VALIDATED+ facts into the LibreChat
# system context before each user turn (Plan 13-05).
# CHAT07_TOP_K: max number of retrieved facts injected per turn.
# CHAT07_TRUTH_FILTER_MIN_LEVEL: minimum truth_level for retrieval
#   (VALIDATED includes VALIDATED + CANONICAL + PUBLIC via >= semantics).
CHAT07_TOP_K=5
CHAT07_TRUTH_FILTER_MIN_LEVEL=WORKING
