# ============================================================================
# xbrain — infrastructure-scoped env template
# ============================================================================
# Canonical env template lives at REPO ROOT: ../.env.example
# This file contains ONLY the Phase 9 (Session Bridge) section as referenced by
# the 09-06 plan's must_haves contract. New deployments should copy the root
# .env.example to .env at repo root; the docker-compose.yml in this directory
# reads from ../ via env_file directives.
# ============================================================================

# ─── Phase 9 — Session Bridge (Pro/Max routing via Chrome extension) ─────────

# Log verbosity for the session-bridge container (info|warning|error|debug).
SESSION_BRIDGE_LOG_LEVEL=info

# BRIDGE_SHARED_SECRET is set in the root .env.example (Phase 1 memory-api).
# session-bridge reuses it to sign HS256 bridge JWTs (acting_user_sub claim)
# when posting register-handshake upserts to memory-api /v1/me/external-sessions.
# Generate with: openssl rand -hex 32  (must match memory-api's value).
# BRIDGE_SHARED_SECRET=__FILL_RANDOM_64_HEX__

# (Optional) xbt_ token used by verify-phase9.sh test 5 to exercise the WS
# upgrade end-to-end. Leave blank — test 5 will be SKIPPED (not failed).
# NEVER commit a real token here.
# VERIFY_XBT_TOKEN=xbt_...

# (Optional) Postgres credential overrides for verify-phase9.sh test 6.
# Defaults to xbrain/xbrain.
# PG_USER=xbrain
# PG_DB=xbrain

# ─── Phase 11 — brain-janitor (daily 03:00 UTC hard-purge) ───────────────────
#
# The brain-janitor container reuses Phase 1 / Phase 3 env vars from the root
# .env — it does NOT introduce new secrets:
#   - DATABASE_URL       (Phase 1 — Postgres)
#   - QDRANT_URL         (Phase 1 — Qdrant)
#   - QDRANT_COLLECTION  (Phase 1 — Qdrant)
#   - NEO4J_URI          (Phase 3 — Neo4j)
#   - NEO4J_USER         (Phase 3 — Neo4j)
#   - NEO4J_PASSWORD     (Phase 3 — Neo4j)
#
# The retention window is hard-pinned to 30 days in docker-compose.yml.
# DO NOT change RETENTION_DAYS without a Phase 11 replan — the value is part
# of the soft-delete contract (see Phase 11 CONTEXT.md §Retention window).
# RETENTION_DAYS=30
