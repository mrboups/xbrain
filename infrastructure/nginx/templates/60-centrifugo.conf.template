# === centrifugo vhost — centrifugo subdomain (quick task 260512-tcr) ===
# WS broker for team chat realtime. Channels team:<id> (broadcast) +
# user:<sub> (Phase 2). Authentication via HMAC JWT issued by memory-api.
#
# Cloudflare real-IP + $connection_upgrade map already declared in 10-xbrain.conf.

server {
    listen 80;
    server_name centrifugo.${XBRAIN_BASE_DOMAIN};
    client_max_body_size 4m;
    access_log /var/log/nginx/centrifugo.access.log;

    location /nginx-health { return 200 "ok\n"; access_log off; }

    # === Centrifugo client WebSocket (extension + PWA mobile in Phase 3) ===
    # Path /connection/websocket is the standard Centrifugo client endpoint.
    location /connection/ {
        set $centrifugo_upstream http://centrifugo:8000;
        proxy_pass $centrifugo_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;

        # WebSocket upgrade
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        # 24h ceiling for long-lived sessions (matches bridge)
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
        proxy_buffering off;
    }

    # === Centrifugo server-side API (publish, presence, history) ===
    # Only memory-api + agent-runtime should hit this from the internal
    # docker network. Cloudflare proxy in front; access controlled by the
    # CENTRIFUGO_API_KEY header (cannot be guessed). For defense in depth,
    # this could be moved to an internal-only path later.
    location /api {
        set $centrifugo_upstream http://centrifugo:8000;
        proxy_pass $centrifugo_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-API-Key $http_x_api_key;
        proxy_set_header Authorization $http_authorization;

        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
    }

    # === Centrifugo health endpoint (passes through to /health on upstream) ===
    location /health {
        set $centrifugo_upstream http://centrifugo:8000;
        proxy_pass $centrifugo_upstream;
        proxy_set_header Host $host;
        access_log off;
    }

    # Catchall — anything else gets 404
    location / { return 404; }
}
