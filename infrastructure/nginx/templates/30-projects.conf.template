# 30-projects.conf — vhost fallback pour le sous-domaine projects
# Normalement, le DNS pointe vers Firebase Hosting (CNAME).
# Ce vhost est un fallback redirect si le DNS est temporairement sur la VM.
#
# Note: resolver directive is declared once globally in 10-xbrain.conf —
# nginx rejects duplicates at top-level.

server {
    listen 80;
    server_name projects.${XBRAIN_BASE_DOMAIN};

    # No real_ip directives here on purpose. This vhost used to declare
    # `set_real_ip_from 0.0.0.0/0` with CF-Connecting-IP, which trusts EVERY source: any
    # client could hand nginx whatever client IP it liked, and everything downstream that
    # reads a client address — access logs, rate limits, abuse investigation — believed it.
    # Redeclaring the directive at server level also REPLACES the inherited list rather than
    # adding to it, so this one line quietly opted the vhost out of the real trust list.
    # 10-xbrain.conf.template declares real_ip_header + the Cloudflare ranges at http level;
    # inheriting them is both correct and the only copy of that list.

    location /nginx-health {
        return 200 "ok\n";
        access_log off;
    }

    # Fallback redirect to the projects-dashboard host. Normally DNS points straight at that
    # host and this vhost is never hit; it exists as a safety net.
    #
    # This target MUST stay operator-configurable (PORT-01). It used to be a hardcoded literal
    # pointing at the original maintainer's own Firebase project, which meant any self-hoster's
    # projects.<their-domain> silently redirected THEIR visitors to SOMEONE ELSE'S site. The
    # brand-token scan could never catch it — the literal contains no brand token at all.
    #
    # Empty (the default) => 404. Never redirect a self-hoster's visitors to a third party just
    # because they left a variable blank. Set XBRAIN_PROJECTS_FALLBACK_URL (scheme + host, no
    # trailing slash) to enable the redirect.
    #
    # The variable must be PRESENT in the container environment — empty is fine, ABSENT is not.
    # The nginx image's envsubst only substitutes vars it finds in the environment, so if this one
    # is missing entirely the `${...}` below survives into the rendered config and nginx dies at
    # boot with an "unknown variable" error. docker-compose.yml guarantees presence via
    # `XBRAIN_PROJECTS_FALLBACK_URL: ${XBRAIN_PROJECTS_FALLBACK_URL:-}` — keep that line.
    location / {
        set $projects_fallback "${XBRAIN_PROJECTS_FALLBACK_URL}";
        if ($projects_fallback = "") {
            return 404;
        }
        return 301 $projects_fallback$request_uri;
    }
}
