# MCP settings — Phase 4 (plan 04-03)
# allowedDomains is required to permit internal Docker network hosts.
# LibreChat v0.8.5 has SSRF protection that blocks non-public domains by default.
# mcp-gateway runs on the xbrain_net bridge — must be explicitly allowed.
mcpSettings:
  allowedDomains:
    - "http://mcp-gateway:8081"
    # Phase 13.x — mcp-brain (active memory tools, per-user xbt_ token auth).
    - "http://mcp-brain:8104"
    # github-read — mcp-github (direct, resolves caller team for github_sync_repo).
    - "http://mcp-github:8107"

# MCP servers — Phase 4 (plan 04-03)
# Connects LibreChat to the xbrain MCP aggregate gateway which exposes
# calendar, drive-read, scraper (and deck after plan 04-08) as a single
# MCP server via streamable-http transport (LibreChat v0.8.5+).
mcpServers:
  xbrain:
    # MCP aggregate endpoint — all registered xbrain tools via mcp-gateway.
    # Requires mcp-gateway:8081 to be running (Phase 4, plan 04-02).
    # Transport: streamable-http (LibreChat v0.8.5+, supported since Q4 2025).
    # Tools: scraper, drive-read, calendar, deck (team-shared, stateless).
    type: streamable-http
    url: http://mcp-gateway:8081/mcp
    headers:
      X-Team-Scope: "${LIBRECHAT_DEFAULT_TEAM_SCOPE}"
      # X-LibreChat-User-Email injected by LibreChat from connected user profile.
      # Consumed by mcp-gateway in Phase 5 for sub resolution via memory-api /v1/me.
      X-LibreChat-User-Email: "{{LIBRECHAT_USER_EMAIL}}"

  # Active team-brain tools — memory_search, memory_add, tasks_list,
  # task_create/update, contacts_search, contact_add, agent_invoke,
  # team_context. Points straight at mcp-brain (not the gateway aggregate,
  # which hardcodes team_scope=default and would break team isolation).
  # mcp-brain resolves the caller's team_scope in two ways:
  #   1. TOKEN PATH: Authorization: Bearer xbt_... (ChatGPT/Claude.ai, explicit token).
  #   2. EMAIL PATH: X-LibreChat-User-Email + X-Internal-Secret — LibreChat-only,
  #      gated by BRIDGE_SHARED_SECRET. Team resolved server-side; no token needed.
  xbrain-memory:
    type: streamable-http
    url: http://mcp-brain:8104/mcp
    headers:
      Authorization: "Bearer {{XBRAIN_TOKEN}}"
      # LibreChat injects the authenticated user's email — used for server-side team
      # resolution when no xbt_ token is set (email path, LibreChat internal only).
      X-LibreChat-User-Email: "{{LIBRECHAT_USER_EMAIL}}"
      # Shared secret gating the email path — prevents public callers from using it.
      # Injected from LibreChat's environment (same BRIDGE_SHARED_SECRET as all services).
      X-Internal-Secret: "${BRIDGE_SHARED_SECRET}"
    customUserVars:
      XBRAIN_TOKEN:
        title: "xbrain API token (optional for LibreChat)"
        description: "Optional for LibreChat users — your team is auto-resolved from your login email. Required for ChatGPT/Claude.ai: copy your xbt_ token from <a href='${APP_TEAMS_URL}' target='_blank'>your team settings</a> (or the Chrome extension)."

  # GitHub repo tools — github_list_files, github_read_file, github_sync_repo.
  # Points straight at mcp-github (NOT the gateway aggregate) so it receives the
  # user email + internal secret and resolves the caller's team server-side —
  # github_sync_repo must land in the right brain, not team_scope=default.
  # Email path only (LibreChat-internal, gated by BRIDGE_SHARED_SECRET).
  xbrain-github:
    type: streamable-http
    url: http://mcp-github:8107/mcp
    headers:
      X-LibreChat-User-Email: "{{LIBRECHAT_USER_EMAIL}}"
      X-Internal-Secret: "${BRIDGE_SHARED_SECRET}"

# File handling (CHAT-04 partial — upload accepted; real RAG comes in Phase 2).
fileConfig:
  endpoints:
    Anthropic:
      fileLimit: 5
      fileSizeLimit: 20
      totalSizeLimit: 50
      supportedMimeTypes:
        - "image/.+"
        - "application/pdf"
    OpenAI:
      fileLimit: 5
      fileSizeLimit: 20
      totalSizeLimit: 50
      supportedMimeTypes:
        - "image/.+"
        - "application/pdf"
