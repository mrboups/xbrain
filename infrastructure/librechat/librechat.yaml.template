version: 1.2.6
cache: true

# Web search (Quick 260601-uom) — self-hosted SearXNG (keyword search) + Firecrawl (reads full
# page content). Adds a "Web Search" toggle (globe) in the chat; when ON the model searches +
# reads the web like claude.ai. rerankerType is OMITTED on purpose: it is optional in v0.8.5's
# schema (z.nativeEnum().optional()) and v0.8.5 has no "none" enum value, so omitting = no
# reranker (fine — reranking is just a relevance re-sort). Keys come from the VM .env.
webSearch:
  searchProvider: "searxng"
  searxngInstanceUrl: "${SEARXNG_INSTANCE_URL}"
  scraperProvider: "firecrawl"
  firecrawlApiKey: "${FIRECRAWL_API_KEY}"
  scraperTimeout: 10000
  safeSearch: 1

interface:
  privacyPolicy:
    externalUrl: ""
    openNewTab: false
  termsOfService:
    externalUrl: ""
    openNewTab: false

registration:
  socialLogins: ["google", "github"]
  allowedDomains:
    - "${LIBRECHAT_ALLOWED_DOMAINS}"
    - "gmail.com"
    # Note: no domain filter for GitHub — org membership is enforced in memory-api (plan 05-02)

# LLM endpoints (API keys are pulled from .env via referenced variables).
endpoints:
  custom:
    - name: "Anthropic"
      apiKey: "${ANTHROPIC_API_KEY}"
      baseURL: "https://api.anthropic.com/v1"
      models:
        default: ["claude-opus-4-7", "claude-sonnet-4-6", "claude-haiku-4-5-20251001"]
        fetch: false
      titleConvo: true
      titleModel: "claude-haiku-4-5-20251001"
      modelDisplayLabel: "Anthropic"

    - name: "OpenAI"
      apiKey: "${OPENAI_API_KEY}"
      baseURL: "https://api.openai.com/v1"
      models:
        default: ["gpt-4o", "gpt-4o-mini", "gpt-4-turbo"]
        fetch: false
      titleConvo: true
      titleModel: "gpt-4o-mini"
      modelDisplayLabel: "OpenAI"

    - name: "xAI"
      apiKey: "${XAI_API_KEY}"
      baseURL: "https://api.x.ai/v1"
      models:
        default: ["grok-3", "grok-2-mini"]
        fetch: false
      titleConvo: false
      modelDisplayLabel: "Grok"

    - name: "Claude Reasoning"
      apiKey: "${ANTHROPIC_API_KEY}"
      baseURL: "https://api.anthropic.com/v1"
      models:
        default: ["claude-sonnet-4-6"]
        fetch: false
      titleConvo: true
      titleModel: "claude-haiku-4-5-20251001"
      modelDisplayLabel: "Claude Reasoning"

    # Phase 9 — session-bridge route through user's Chrome extension
    # so the user's own Claude Pro/Max subscription quota is consumed.
    # apiKey: user_provided → LibreChat sends what the user pastes as
    # Authorization: Bearer <xbt_token>. session-bridge validates against
    # memory-api /v1/me, looks up the user's WS, relays the chat.
    # NOTE: name must NOT contain "/" — LibreChat routes custom endpoints via
    # /api/.../{name}, so a slash splits the path → "Endpoint not found" and the
    # request never reaches baseURL. Keep the slash only in modelDisplayLabel.
    - name: "Claude Pro Max"
      apiKey: "user_provided"
      baseURL: "${BRIDGE_BASE_URL}"
      models:
        default: ["claude-opus-4-7", "claude-sonnet-4-6"]
        fetch: false
      titleConvo: true
      titleModel: "claude-sonnet-4-6"
      modelDisplayLabel: "Claude Pro/Max"

# Model specs — make the xbrain MCP server active by DEFAULT in every new chat.
# v0.8.5 has no per-conversation "pre-check this tool" flag, so we use modelSpecs:
# each spec attaches `mcpServers: ["xbrain"]`, so selecting it auto-loads the
# xbrain tools (memory_search/add, tasks, contacts, calendar, drive, deck).
# `prioritize: true` + one `default: true` spec → a spec is always pre-selected
# on a fresh conversation, so xbrain is on without any manual toggle.
# `enforce: false` + `addedEndpoints` keep every raw endpoint/model selectable
# too — nothing is removed, the specs are just the curated default path.
# (Passive recall — per-turn CANONICAL/WORKING fact injection via
# librechat-bridge message_enricher — already runs for ALL conversations
# regardless of spec/tool selection; these specs add the ACTIVE tool path.)
modelSpecs:
  enforce: false
  prioritize: true
  addedEndpoints:
    - "Anthropic"
    - "OpenAI"
    - "xAI"
    - "Claude Reasoning"
    - "Claude Pro Max"
  list:
    - name: "xbrain-sonnet"
      label: "Claude Sonnet 4.6 · xbrain"
      default: true
      description: "Claude Sonnet with the team brain tools on by default."
      mcpServers: ["xbrain", "xbrain-memory", "xbrain-github"]
      preset:
        promptPrefix: "You are the assistant for GrooveOS — an open-source collective memory for teams of humans and AI agents. All knowledge lives in one team-scoped brain shared across LibreChat, the Chrome extension (mention @groove), and ChatGPT/Claude.ai via MCP. Every fact carries a tagging contract with a truth_level: raw (EPHEMERAL) then work (WORKING) then validated then production (CANONICAL); promotion is human-only and EPHEMERAL items are ignored in recall by default. Tools you can use and explain: memory_search returns full team knowledge at any truth level (prefer it for internal/team questions); memory_add stores a new fact at work level; github_list_files and github_read_file browse and read any sanctioned GitHub repo; github_sync_repo indexes a repo's files into the team brain so it becomes searchable (afterwards use memory_search with project_scope set to the repo); contacts_search and contact_add manage the team CRM (people are also auto-extracted from chat); tasks_list, task_create and task_update manage tasks (also auto-created from action language). A knowledge graph (Graphiti + Neo4j) extracts entities and relationships from content for lineage and dependency queries (backend capability). Files uploaded to the brain render inline. The Brain Monitor at /account/teams/brain/ lets users view, promote truth_level, and soft-delete memory. When the user's message contains a URL, call the scraper tool to fetch and read it before answering. For internal or team knowledge, prefer the memory_search tool. Never reveal another team's data or invent internal details that are not in the brain."
        endpoint: "Anthropic"
        model: "claude-sonnet-4-6"

    - name: "xbrain-opus"
      label: "Claude Opus 4.7 · xbrain"
      description: "Claude Opus with the team brain tools on by default."
      mcpServers: ["xbrain", "xbrain-memory", "xbrain-github"]
      preset:
        promptPrefix: "You are the assistant for GrooveOS — an open-source collective memory for teams of humans and AI agents. All knowledge lives in one team-scoped brain shared across LibreChat, the Chrome extension (mention @groove), and ChatGPT/Claude.ai via MCP. Every fact carries a tagging contract with a truth_level: raw (EPHEMERAL) then work (WORKING) then validated then production (CANONICAL); promotion is human-only and EPHEMERAL items are ignored in recall by default. Tools you can use and explain: memory_search returns full team knowledge at any truth level (prefer it for internal/team questions); memory_add stores a new fact at work level; github_list_files and github_read_file browse and read any sanctioned GitHub repo; github_sync_repo indexes a repo's files into the team brain so it becomes searchable (afterwards use memory_search with project_scope set to the repo); contacts_search and contact_add manage the team CRM (people are also auto-extracted from chat); tasks_list, task_create and task_update manage tasks (also auto-created from action language). A knowledge graph (Graphiti + Neo4j) extracts entities and relationships from content for lineage and dependency queries (backend capability). Files uploaded to the brain render inline. The Brain Monitor at /account/teams/brain/ lets users view, promote truth_level, and soft-delete memory. When the user's message contains a URL, call the scraper tool to fetch and read it before answering. For internal or team knowledge, prefer the memory_search tool. Never reveal another team's data or invent internal details that are not in the brain."
        endpoint: "Anthropic"
        model: "claude-opus-4-7"

    - name: "xbrain-pro-max"
      label: "Claude Pro/Max · xbrain"
      description: "Routes through your own Claude Pro/Max quota (Chrome extension) with the team brain tools on."
      mcpServers: ["xbrain", "xbrain-memory", "xbrain-github"]
      preset:
        promptPrefix: "You are the assistant for GrooveOS — an open-source collective memory for teams of humans and AI agents. All knowledge lives in one team-scoped brain shared across LibreChat, the Chrome extension (mention @groove), and ChatGPT/Claude.ai via MCP. Every fact carries a tagging contract with a truth_level: raw (EPHEMERAL) then work (WORKING) then validated then production (CANONICAL); promotion is human-only and EPHEMERAL items are ignored in recall by default. Tools you can use and explain: memory_search returns full team knowledge at any truth level (prefer it for internal/team questions); memory_add stores a new fact at work level; github_list_files and github_read_file browse and read any sanctioned GitHub repo; github_sync_repo indexes a repo's files into the team brain so it becomes searchable (afterwards use memory_search with project_scope set to the repo); contacts_search and contact_add manage the team CRM (people are also auto-extracted from chat); tasks_list, task_create and task_update manage tasks (also auto-created from action language). A knowledge graph (Graphiti + Neo4j) extracts entities and relationships from content for lineage and dependency queries (backend capability). Files uploaded to the brain render inline. The Brain Monitor at /account/teams/brain/ lets users view, promote truth_level, and soft-delete memory. When the user's message contains a URL, call the scraper tool to fetch and read it before answering. For internal or team knowledge, prefer the memory_search tool. Never reveal another team's data or invent internal details that are not in the brain."
