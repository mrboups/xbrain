# ==========================================================
# xbrain Phase 1 — environment template
# Copy to .env and fill in values. Never commit .env.
# ==========================================================

# --- Domain / network ---
# Pas de domaine en Phase 1 — on utilise l'IP brute.
# Ces vars seront utilisées par LibreChat et nginx.
DOMAIN_URL=http://__VM_HOST__
DOMAIN_CLIENT=http://__VM_HOST__
DOMAIN_SERVER=http://__VM_HOST__

# --- Google OAuth (1 client unique partagé entre les 2 frontends) ---
GOOGLE_CLIENT_ID=__FILL__
GOOGLE_CLIENT_SECRET=__FILL__
GOOGLE_CALLBACK_URL=http://__VM_HOST__/oauth/google/callback
GOOGLE_REDIRECT_URI=http://__VM_HOST__/openwebui/oauth/google/callback

# --- Provider API keys (LibreChat & memory-api) ---
ANTHROPIC_API_KEY=__FILL__
OPENAI_API_KEY=__FILL__
XAI_API_KEY=__FILL__

# --- PostgreSQL (memory-api) ---
POSTGRES_USER=xbrain
POSTGRES_PASSWORD=__FILL_RANDOM_32_CHARS__
POSTGRES_DB=xbrain
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://xbrain:__FILL_RANDOM_32_CHARS__@postgres:5432/xbrain

# --- Qdrant (memory-api) ---
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=

# --- memory-api ---
MEMORY_API_URL=http://memory-api:8000
MEMORY_API_PUBLIC_BASE=http://__VM_HOST__/api
JWT_ALGORITHM=HS256
BRIDGE_SHARED_SECRET=__FILL_RANDOM_64_CHARS__
LOG_LEVEL=INFO

# --- LibreChat ---
APP_TITLE=xbrain
HOST=0.0.0.0
PORT=3080
MONGO_URI=mongodb://librechat-mongo:27017/LibreChat
MEILI_HOST=http://librechat-meili:7700
MEILI_MASTER_KEY=__FILL_RANDOM_32_CHARS__
ALLOW_REGISTRATION=true
ALLOW_SOCIAL_LOGIN=true
ALLOW_SOCIAL_REGISTRATION=true
SESSION_EXPIRY=604800000
REFRESH_TOKEN_EXPIRY=2592000000
JWT_SECRET=__FILL_RANDOM_64_CHARS__
JWT_REFRESH_SECRET=__FILL_RANDOM_64_CHARS__
CREDS_KEY=__FILL_RANDOM_64_HEX__
CREDS_IV=__FILL_RANDOM_32_HEX__

# --- Open WebUI ---
WEBUI_AUTH=true
ENABLE_OAUTH_SIGNUP=true
OAUTH_PROVIDER_NAME=Google
OAUTH_GOOGLE_CLIENT_ID=__FILL__
OAUTH_GOOGLE_CLIENT_SECRET=__FILL__
OPENWEBUI_SECRET_KEY=__FILL_RANDOM_64_CHARS__
OPENAI_API_BASE_URL=http://openwebui-pipeline:9099

# --- librechat-bridge ---
LIBRECHAT_MONGO_URI=mongodb://librechat-mongo:27017/LibreChat?replicaSet=rs0
BRIDGE_BACKFILL_FROM=startup
BRIDGE_DEFAULT_TEAM_SCOPE=default

# --- openwebui-pipeline ---
PIPELINE_API_KEY=__FILL_RANDOM_32_CHARS__
PIPELINE_DEFAULT_TEAM_SCOPE=default

# --- Langfuse self-hosted (Plan 02-09) ---
# DB lives inside the same Postgres instance, separate logical database.
# Run once: docker exec xbrain-postgres psql -U xbrain -c "CREATE DATABASE langfuse OWNER xbrain;"
LANGFUSE_POSTGRES_URL=postgresql://xbrain:__FILL_POSTGRES_PASSWORD__@postgres:5432/langfuse
LANGFUSE_HOST=https://lang.dejavu.cat
# Generate with: openssl rand -base64 32
LANGFUSE_CLICKHOUSE_PASSWORD=__FILL_RANDOM_32_CHARS__
LANGFUSE_REDIS_PASSWORD=__FILL_RANDOM_32_CHARS__
# Generate with: openssl rand -base64 64
LANGFUSE_SALT=__FILL_RANDOM_64_CHARS__
LANGFUSE_NEXTAUTH_SECRET=__FILL_RANDOM_64_CHARS__
# Generate with: openssl rand -hex 32
LANGFUSE_ENCRYPTION_KEY=__FILL_RANDOM_64_HEX__
# Bootstrap admin (used only on first boot)
LANGFUSE_INIT_USER_EMAIL=team@grooveos.app
LANGFUSE_INIT_USER_NAME=xbrain admin
LANGFUSE_INIT_PROJECT_NAME=xbrain
# Filled AFTER first login at $LANGFUSE_HOST → Settings → API Keys
LANGFUSE_PUBLIC_KEY=__SET_AFTER_FIRST_LOGIN__
LANGFUSE_SECRET_KEY=__SET_AFTER_FIRST_LOGIN__

# === Neo4j Community (plan 03-01) — graph store ===
# Utilisé par memory-api (outbox worker + graph endpoints) via AsyncGraphDatabase
# NEO4J_URI: bolt:// pour le driver Python neo4j (port 7687, réseau interne)
# Password: openssl rand -base64 24  (éviter / et + qui cassent les URLs)
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=__FILL_RANDOM_32__

# === Drive admin OAuth (plan 03-10) ===
# External URL for the memory-api (used to build the OAuth redirect_uri)
MEMORY_API_EXTERNAL_URL=https://x.dejavu.cat
# Fernet encryption key for storing OAuth credentials at rest
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
OAUTH_CREDENTIALS_ENCRYPTION_KEY=__FILL_FERNET_KEY__
# GOOGLE_CLIENT_SECRET is the same credential used for Phase 1 Google OAuth — already set above

# === Calendar credentials for mcp-calendar sidecar (plan 03-09) ===
# Obtain these after Google OAuth consent for calendar.readonly scope
# See docs/google-oauth-scope-upgrade.md for setup steps
GOOGLE_CALENDAR_ACCESS_TOKEN=__FILL_AFTER_OAUTH__
GOOGLE_CALENDAR_REFRESH_TOKEN=__FILL_AFTER_OAUTH__

# === Drive credentials for mcp-drive-read sidecar (plan 03-08) ===
# Obtain these after Google OAuth consent for drive.readonly + drive.file scopes
# See docs/google-oauth-scope-upgrade.md for incremental auth setup
# GOOGLE_CLIENT_SECRET is already set above (shared Google OAuth client)
GOOGLE_DRIVE_ACCESS_TOKEN=__FILL_AFTER_OAUTH__
GOOGLE_DRIVE_REFRESH_TOKEN=__FILL_AFTER_OAUTH__

# === MCP Gateway (plan 03-06) ===
# Utilise DATABASE_URL, BRIDGE_SHARED_SECRET, GOOGLE_CLIENT_ID existants — pas de nouvelles vars.
# Port interne : 8080 (xbrain_net uniquement). Pas exposé sur l'hôte sauf accès direct requis.

# --- Backups (Phase 1 = local + GCS) ---
GCS_BACKUP_BUCKET=xbrain-backups-prod
GCS_SERVICE_ACCOUNT_KEY=/secrets/gcs-backup-sa.json
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4

# --- VM (utilisé par Makefile, pas par les containers) ---
VM_HOST=__VM_HOST__
VM_USER=user
SSH_KEY=~/.ssh/xbrain_key
