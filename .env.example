# ==========================================================
# xbrain — environment template
# ==========================================================
# Fastest path: run `make oss-init` — it writes a complete zero-external-key `.env`
# for the OSS-light core (random secrets, no keys to paste). Then optionally add ONE
# LLM key for chat/extraction. Run `make env-check` to verify before deploying.
#
# To fill by hand instead: copy to `.env`, set every `[required]` var in the
# first section (core boot) below, leave the rest — they have safe defaults or
# belong to opt-in profiles. Never commit `.env`.
#
# Four sections, in priority order:
#   1. core boot (REQUIRED)       the 10-service OSS-light core — the only vars you MUST set
#   2. one LLM key (OPTIONAL)     Anthropic OR OpenAI OR Grok — enhancement, not required for SC#3
#   3. integrations (OPTIONAL)    Neo4j, Graphiti, Google, GitHub, Granola, Drive/Calendar, SMTP…
#   4. saas frontends (OPTIONAL)  the bundled LibreChat / Open WebUI frontends, Langfuse, backups
# ==========================================================


# ===================================================================================================
# === [REQUIRED — core boot] the 10-service OSS-light core (COMPOSE_PROFILES unset) ===
# ===================================================================================================
# These are the ONLY vars the 10 core services need to boot with ZERO external keys:
#   nginx, postgres, qdrant, memory-api, minio, centrifugo, mcp-brain, mcp-gateway,
#   mcp-scraper, brain-janitor.
# Every secret here should be a fresh CSPRNG value (`make oss-init` does this for you).

# --- Edition & profiles (Phase 15) -------------------------------------------------------------
# TWO knobs decide the shape of your install. Both are deployment-time; neither needs a rebuild.
#
# COMPOSE_PROFILES — WHICH CONTAINERS RUN. Comma-separated; empty = the OSS-light core only
#   (10 services: nginx, postgres, qdrant, memory-api, minio, centrifugo, mcp-brain, mcp-gateway,
#   mcp-scraper, brain-janitor). Opt in to any combination of:
#     integrations — neo4j + graphiti + langfuse (+ its clickhouse/redis) + the mcp-* integration
#                    tools + searxng + drive/granola sync + agent-runtime.  (~+4 GB RAM)
#     saas         — the bundled frontends: librechat (+ its mongo/meili/bridge), openwebui
#                    (+ its pipeline), session-bridge.
#     ops          — xbrain-backup (the nightly Postgres/Qdrant/Mongo backup job).
#   Nothing here is paywalled. Neo4j is opt-in only because it costs ~1 GB of RAM.
#   Example: COMPOSE_PROFILES=integrations,ops
# [required] empty = OSS-light core (10 services) — comment kept ABOVE this blank-valued
# assignment: docker compose's env-file parser does not strip an inline # comment on a
# genuinely blank value (see the MINIO_URL/ACCESS_KEY/SECRET_KEY fix below), so a trailing
# comment here would resolve COMPOSE_PROFILES to the literal comment text instead of empty.
COMPOSE_PROFILES=
#
# EDITION — WHICH memory-api ROUTES MOUNT. oss | saas. Same image either way.
#   oss  (default) — everything a self-hoster needs. No feature is withheld.
#   saas           — additionally mounts the hosted-control-plane routes (waitlist,
#                    external_sessions). Only useful if you run the hosted control plane.
#   Any other value (including `pro` — there is no pro edition) is REJECTED at boot.
#   INVARIANT: if COMPOSE_PROFILES contains `saas`, set EDITION=saas. session-bridge calls
#   /v1/me/external-sessions, which EDITION=oss does not mount — it would get a 404.
EDITION=oss                                                                   # [required] oss | saas

# --- PostgreSQL (memory-api event store + vector-scoping metadata) ---
POSTGRES_USER=xbrain                                                          # [optional] role name
POSTGRES_PASSWORD=__FILL_RANDOM_32_CHARS__                                    # [required] keep in sync with the password embedded in DATABASE_URL below
POSTGRES_DB=xbrain                                                            # [optional] database name
POSTGRES_HOST=postgres                                                        # [optional] internal Docker service name — leave as-is
POSTGRES_PORT=5432                                                            # [optional]
DATABASE_URL=postgresql+asyncpg://xbrain:__FILL_RANDOM_32_CHARS__@postgres:5432/xbrain  # [required] memory-api's async SQLAlchemy DSN — the password MUST equal POSTGRES_PASSWORD above

# --- Cross-service auth ---
BRIDGE_SHARED_SECRET=__FILL_RANDOM_64_CHARS__                                 # [required] HMAC secret memory-api uses to sign/verify internal service JWTs (mcp-brain + every sidecar)
JWT_ALGORITHM=HS256                                                           # [required] algorithm for the secret above
LOG_LEVEL=INFO                                                                # [optional] shared log verbosity across memory-api and every Python sidecar

# --- Qdrant (memory-api vector search) ---
QDRANT_URL=http://qdrant:6333                                                 # [required]
# [optional] leave blank for the bundled unauthenticated Qdrant container
QDRANT_API_KEY=

# --- Realtime team chat (Centrifugo) — generate both with: openssl rand -hex 32 ---
CENTRIFUGO_TOKEN_HMAC_SECRET=__FILL_RANDOM_64_HEX__                           # [required] signs client WS auth tokens issued by memory-api
CENTRIFUGO_API_KEY=__FILL_RANDOM_64_HEX__                                     # [required] server-side publish/presence/history calls
CENTRIFUGO_HTTP_URL_INTERNAL=http://centrifugo:8000                          # [optional] internal Docker service name — leave as-is

# --- Cross-service memory-api URL (internal Docker service name — leave as-is) ---
MEMORY_API_URL=http://memory-api:8000                                        # [required] used by mcp-brain and every sidecar to reach memory-api

# === Embeddings (Phase 19, EMBED-01) — local & keyless by default ===
# A fresh install ingests + semantically retrieves memory with NO embeddings key: the model runs
# in-container (baked into the memory-api image at build, zero network at runtime). Switch to
# EMBEDDINGS_PROVIDER=openai (+ OPENAI_API_KEY below) for the 1536-dim OpenAI path.
EMBEDDINGS_PROVIDER=local                                                     # [required] local (keyless, in-container, default) | openai (needs OPENAI_API_KEY)
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5                                  # [optional] baked into the image at build; leave as-is
UVICORN_WORKERS=1                                                             # [required] OSS-light: 1 worker (loads the local model once). SaaS: 2.

# === Domain / public URLs (neutral defaults ship working; set these for a real deploy) ===

# THE domain knob: one var repoints every nginx vhost
# (chat./api./mcp./adm./lang./bridge./centrifugo./projects.<domain>).
XBRAIN_BASE_DOMAIN=localhost                                                  # [required] default: localhost (local dev). Set to your real domain to deploy.

# Fallback target for the projects.<domain> vhost, which normally has DNS pointed straight at
# your dashboard host and is never hit. Leave EMPTY and that vhost returns 404 — it must never
# redirect your visitors to somebody else's site. Scheme + host, no trailing slash.
# Must keep the XBRAIN_ prefix: nginx only substitutes vars matching NGINX_ENVSUBST_FILTER=^XBRAIN_.
# [optional] e.g. https://dashboard.yourdomain.com — empty = 404
XBRAIN_PROJECTS_FALLBACK_URL=

MEMORY_API_EXTERNAL_URL=http://localhost:8000                                 # [optional] external base URL of memory-api — used to build OAuth redirect_uris

# Browser origins allowed to call memory-api. If you serve a web app or a
# browser extension from your own domain, ADD IT HERE or the browser will be
# CORS-blocked. Do NOT set this to `.*` — that lets any site make
# credentialed calls (memory-api rejects `.*` at boot). Default: chrome-extension + localhost.
# [required] SINGLE-QUOTED so `make env-check`'s `source .env` does not read the leading `(` as a
# bash array assignment; docker compose strips the quotes on interpolation.
# The board SPA makes no direct API call in 26a (its token is handed over in the URL
# fragment), so no board origin is needed here. If a later slice has the board page
# call this API directly, add its exact origin — never widen this to `.*`.
CORS_ALLOWED_ORIGIN_REGEX='(chrome-extension://.*|http://localhost(:\d+)?)'

# Comma-separated aliases that summon the agent in team chat, WITHOUT the
# leading '@'. Default: `agent` (so users type `@agent`). Add your own
# alongside it, e.g. `AGENT_MENTION_ALIASES=agent,ai,assistant` — every alias
# in the list works, so keeping `agent` first means `@agent` always resolves.
# A rebrand is a change here, not in code.
# The FIRST alias in the list is also the one the assistant names in its own
# system prompt (LibreChat renders `mention @<first>`), so put the alias you
# want advertised first. Order is cosmetic only: the detector treats the list
# as a set, so every alias resolves regardless of position.
AGENT_MENTION_ALIASES=agent                                                   # [required]

# === OAuth identity — REQUIRED. Empty = memory-api and mcp-brain CRASH AT BOOT (by design) ===
# These have NO default. A misleading default would silently mint tokens
# bound to the wrong resource, so an empty value fails fast at boot instead.
# `make env-check` also refuses to deploy without them.
# [required] public base URL of THIS deployment's authorization server, e.g. https://api.yourdomain.com
OAUTH_ISSUER_URL=
# [required] the mcp-brain audience issued tokens are bound to (RFC 8707), e.g. https://mcp.yourdomain.com/mcp
OAUTH_RESOURCE_URL=
# [required] Fernet key encrypting stored OAuth/media credentials at rest. Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# (FERNET_KEY in the integrations section falls back to this when blank.)
OAUTH_CREDENTIALS_ENCRYPTION_KEY=__FILL_FERNET_KEY__

# === MinIO / object storage (core — backs /v1/media/upload) ===
MINIO_ROOT_USER=minio                                                        # [required] MinIO root access key
# [required] MINIO ROOT SECRET — MUST be >= 8 chars. The core `minio` container REFUSES to boot
# with a root password under 8 chars (an empty/short value crashloops the core service). Generate:
#   openssl rand -hex 16   (32 hex chars, well above the floor). memory-api's MINIO_SECRET_KEY
# falls back to this value, so it also backs media uploads. Do NOT leave blank.
MINIO_ROOT_PASSWORD=__FILL_RANDOM_32_CHARS__                                  # [required] >= 8 chars — MinIO crashloops below 8
MINIO_ENDPOINT=minio:9000                                                     # [optional] internal Docker service name — leave as-is
MINIO_BUCKET=xbrain-media                                                     # [optional] bucket memory-api writes media to

# --- Optional MinIO override trio (Brain Monitor superadmin storage endpoint + media fallback) ---
# Defaults empty -> memory-api derives them from MINIO_ENDPOINT / MINIO_ROOT_USER / MINIO_ROOT_PASSWORD
# above, so a core install leaves all three blank. NO trailing inline comment on these 3 blank values —
# `docker compose --env-file` does NOT strip an inline `#` on a genuinely blank value (verified live),
# so `KEY=   # comment` resolves to the literal string "# comment", not empty. That defeated both the
# fail-soft empty-check AND docker-compose.yml's `${MINIO_URL:-...}` core default, breaking
# /v1/media/upload's fallback in every install that booted straight off this file.
MINIO_URL=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
QDRANT_COLLECTION=messages                                                    # [optional] Qdrant collection memory-api writes to AND brain-janitor purges — both must agree, so change it here or nowhere


# ===================================================================================================
# === [OPTIONAL — one LLM key: none needed for the SC#3 zero-key flow] ===
# ===================================================================================================
# Doc ingest + local embeddings + semantic retrieval are keyless (Phase 18/19). A key here only adds
# LLM extraction + the in-chat agent (D-16-01). Set at most one; leave all blank for the pure zero-key core.
ANTHROPIC_API_KEY=__FILL__                                                    # [optional] Claude in LibreChat + memory-api's relevance filter/extraction ENHANCEMENTS (not the keyless ingest path)
OPENAI_API_KEY=__FILL__                                                       # [optional] GPT in LibreChat. Embeddings are LOCAL by default (Phase 19) — a key is only needed here if EMBEDDINGS_PROVIDER=openai
XAI_API_KEY=__FILL__                                                          # [optional] Grok in LibreChat


# ===================================================================================================
# === [OPTIONAL — integrations profile] (COMPOSE_PROFILES includes integrations) ===
# ===================================================================================================
# Safe to leave blank — each feature no-ops (fail-soft) when its keys are absent.

# --- Google OAuth (shared by LibreChat, Open WebUI, memory-api's Drive/Calendar sidecars) ---
GOOGLE_CLIENT_ID=__FILL__                                                     # [optional]
GOOGLE_CLIENT_SECRET=__FILL__                                                 # [optional]
GOOGLE_CALLBACK_URL=http://localhost:3080/oauth/google/callback               # [optional] LibreChat's OAuth callback path
GOOGLE_REDIRECT_URI=http://localhost:8080/openwebui/oauth/google/callback     # [optional] Open WebUI's OAuth callback path
OAUTH_GOOGLE_CLIENT_ID=__FILL__                                               # [optional] Open WebUI reads its OAuth client under this name — usually the same value as GOOGLE_CLIENT_ID
OAUTH_GOOGLE_CLIENT_SECRET=__FILL__                                           # [optional] same as above, secret half

# --- GitHub App (repo indexing, org-driven team membership, contents:read) ---
# Register your own GitHub App; download the private key once and base64-encode it:
#   openssl base64 -A -in your-app.pem
# [optional] numeric App ID
GITHUB_APP_ID=
GITHUB_APP_SLUG=xbrain-auth                                                   # [optional] URL slug for the install URL (github.com/apps/<slug>/installations/new)
# [optional]
GITHUB_APP_CLIENT_ID=
# [optional]
GITHUB_APP_CLIENT_SECRET=
# [optional] base64-encoded PEM, single line
GITHUB_APP_PRIVATE_KEY_B64=
# [optional] HMAC-SHA256 secret for the installation webhook
GITHUB_APP_WEBHOOK_SECRET=
# [optional] stopgap `repo`-scope PAT used when the App isn't installed on a repo owner — empty = App-only reads
GITHUB_FALLBACK_TOKEN=

# --- GitHub OAuth App (LibreChat account-linking — separate concern from the GitHub App above) ---
# [optional]
GITHUB_CLIENT_ID=
# [optional]
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=/oauth/github/callback                                    # [optional]
# [optional] org used for org-driven team membership checks
GITHUB_ORG=

# --- GitHub repo-catalog auto-indexer — safe defaults, no .env change required ---
GITHUB_CATALOG_ENABLED=true                                                   # [optional]
GITHUB_CATALOG_CONCURRENCY=5                                                  # [optional] max parallel upserts per backfill batch
GITHUB_CATALOG_README_CHARS=8000                                              # [optional] README input cap before the Haiku summarization call

# --- SMTP (task-assignment + team-invite notifications) — blank = notifications skipped, fail-soft ---
# [optional]
SMTP_HOST=
SMTP_PORT=587                                                                 # [optional]
# [optional]
SMTP_USER=
# [optional]
SMTP_PASSWORD=
SMTP_TLS=true                                                                 # [optional]
SMTP_FROM=noreply@example.com                                                 # [optional] "From" address for task-notification emails — SMTP_HOST empty = emails skipped (fail-soft)
APP_PUBLIC_URL=http://localhost:8000                                          # [optional] used in outbound email links (invite/notification emails)

# --- Waitlist email proxy (landing page signup form) ---
# [optional]
RESEND_API_KEY=
WAITLIST_TO=team@example.com                                                  # [optional]
WAITLIST_FROM=Example <waitlist@example.com>                                  # [optional]

# --- Granola meeting-notes sync (CRM + Tasks extraction) ---
GRANOLA_API_BASE=https://api.granola.ai                                       # [optional]
GRANOLA_POLL_INTERVAL_SECONDS=300                                             # [optional]
ANTHROPIC_MODEL=claude-3-5-haiku-20241022                                     # [optional] note extraction model for granola-sync
# [optional] encrypts Granola API keys + Drive OAuth credentials at rest — falls back to OAUTH_CREDENTIALS_ENCRYPTION_KEY (core) when blank. Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# --- Contact extraction from chat (opt-in — explicit to avoid unexpected Anthropic spend) ---
CONTACT_EXTRACTION=false                                                      # [optional]
ANTHROPIC_CONTACT_MODEL=claude-haiku-4-5-20251001                             # [optional]

# --- Chat -> Brain Ingestion + Retrieval Enrichment ---
RELEVANCE_HAIKU_ENABLED=true                                                  # [optional] Haiku relevance filter before brain upsert; falls back to a >=15-char heuristic when false/ANTHROPIC_API_KEY absent
RELEVANCE_DAILY_TOKEN_CAP_PER_TEAM=50000                                      # [optional]
RELEVANCE_HAIKU_MODEL=claude-haiku-4-5-20251001                              # [optional]
RELEVANCE_HAIKU_TIMEOUT_S=3.0                                                 # [optional]
BRAIN_INGEST_ENABLED=true                                                     # [optional] kill-switch for LibreChat/Open WebUI -> brain ingest and per-turn enrichment
CHAT07_TOP_K=5                                                                # [optional] facts injected into the system context per turn
CHAT07_TRUTH_FILTER_MIN_LEVEL=WORKING                                        # [optional] minimum truth_level for retrieval (>= semantics)

# --- Image description on upload (makes an uploaded IMAGE's content recallable) ---
# Sends uploaded images to Anthropic so a vision model can describe them; the description is
# stored as a linked child memory_item (the caption is never overwritten). Set ENABLED=false
# to refuse that data egress entirely — nothing then leaves the box. With no ANTHROPIC_API_KEY
# the path is simply absent and records "skipped (vision_unavailable)" on the parent item.
VISION_DESCRIBE_ENABLED=true                                                  # [optional] kill-switch for the whole describe-on-upload path (third-party image egress)
VISION_DESCRIBE_MODEL=claude-haiku-4-5-20251001                               # [optional] separate from RELEVANCE_HAIKU_MODEL on purpose — different job, different cost profile
VISION_DESCRIBE_TIMEOUT_S=30.0                                                # [optional]
VISION_DESCRIBE_MAX_TOKENS=500                                                # [optional] ceiling on the generated description length
VISION_DAILY_TOKEN_CAP_PER_TEAM=200000                                        # [optional] own bucket, separate from RELEVANCE_DAILY_TOKEN_CAP_PER_TEAM; exhausted => skipped, never retried
VISION_MAX_IMAGE_BYTES=5242880                                                # [optional] Anthropic per-image cap, checked on the base64 payload BEFORE the call
VISION_MAX_IMAGE_DIMENSION=8000                                               # [optional] px on either edge; larger images are skipped, not sent

# --- Google Drive + Calendar sidecars (incremental OAuth scopes) ---
GOOGLE_DRIVE_ACCESS_TOKEN=__FILL_AFTER_OAUTH__                                # [optional]
GOOGLE_DRIVE_REFRESH_TOKEN=__FILL_AFTER_OAUTH__                               # [optional]
GOOGLE_CALENDAR_ACCESS_TOKEN=__FILL_AFTER_OAUTH__                            # [optional]
GOOGLE_CALENDAR_REFRESH_TOKEN=__FILL_AFTER_OAUTH__                            # [optional]
DRIVE_SYNC_POLL_INTERVAL=300                                                  # [optional] seconds — keep at 300 in production to respect Drive API quotas

# --- Neo4j (graph store — entity lineage, dependency mapping) ---
# Also reused as-is (no new vars) by the brain-janitor container, which hard-purges
# soft-deleted rows older than a 30-day retention window pinned in docker-compose.yml —
# do not expect a RETENTION_DAYS override here without a schema/contract change.
NEO4J_URI=bolt://neo4j:7687                                                   # [optional]
NEO4J_USER=neo4j                                                              # [optional]
NEO4J_PASSWORD=__FILL_RANDOM_32__                                            # [optional] generate: openssl rand -base64 24 (avoid `/` and `+`, they break URLs)

# --- Temporal fact extraction (graphiti-service) — reuses OPENAI_API_KEY / ANTHROPIC_API_KEY above ---
GRAPHITI_LLM_MODEL=claude-haiku-4-5-20251001                                 # [optional]
GRAPHITI_SERVICE_URL=http://graphiti-service:8300                           # [optional]

# --- Internal service wiring (safe defaults — internal Docker service names) ---
AGENT_RUNTIME_INTERNAL_URL=http://agent-runtime:8200                          # [optional] memory-api -> agent-runtime on @mentions (fire-and-forget)
LIBRECHAT_INTERNAL_URL=http://librechat:3080                                  # [optional] memory-api's /v1/github/repos proxy target — 503 without it
MCP_GATEWAY_URL=http://mcp-gateway:8080                                       # [optional] used by infrastructure/scripts/register-mcp-tools.sh

# --- GCP Cloud Run CI deploy (only relevant if you use the bundled GitHub Actions template) ---
# [optional]
GCP_PROJECT_NUMBER=


# ===================================================================================================
# === [OPTIONAL — saas profile] bundled frontends (COMPOSE_PROFILES includes saas; set EDITION=saas) ===
# ===================================================================================================
# The LibreChat / Open WebUI bundled chat frontends, plus Langfuse observability and the backup/ops
# knobs. NONE of these are needed for the OSS-light core — every value below is [optional] for a
# zero-key core boot and only becomes relevant once you opt into the saas (or integrations/ops) profile.

# --- LibreChat search index + Open WebUI session signing ---
MEILI_MASTER_KEY=__FILL_RANDOM_32_CHARS__                                     # [optional] saas profile only — LibreChat MeiliSearch master key
OPENWEBUI_SECRET_KEY=__FILL_RANDOM_64_CHARS__                                 # [optional] saas profile only — Open WebUI session signing key

# --- LibreChat's own secrets — generate: openssl rand -hex 32 (CREDS_IV: openssl rand -hex 16) ---
JWT_SECRET=__FILL_RANDOM_64_CHARS__                                           # [optional] saas profile only
JWT_REFRESH_SECRET=__FILL_RANDOM_64_CHARS__                                   # [optional] saas profile only
CREDS_KEY=__FILL_RANDOM_64_HEX__                                              # [optional] saas profile only — encrypts stored user credentials — must be 32 bytes hex
CREDS_IV=__FILL_RANDOM_32_HEX__                                               # [optional] saas profile only — must be 16 bytes hex

# --- LibreChat's Mongo + search connections (internal Docker service names — leave as-is) ---
MONGO_URI=mongodb://librechat-mongo:27017/LibreChat                          # [optional] saas profile only
MEILI_HOST=http://librechat-meili:7700                                       # [optional] saas profile only
LIBRECHAT_MONGO_URI=mongodb://librechat-mongo:27017/LibreChat?replicaSet=rs0  # [optional] saas profile only — librechat-bridge's change-stream connection — needs the replicaSet query param

# --- LibreChat's own internal session/domain behavior (SEPARATE from XBRAIN_BASE_DOMAIN in the
#     core section — these are consumed directly by the LibreChat container's own cookie/CORS
#     handling, not the nginx ingress) ---
APP_TITLE=xbrain                                                             # [optional] displayed in the LibreChat UI
DOMAIN_CLIENT=http://localhost:3080                                          # [optional] set to your real chat.<domain> for a deploy
DOMAIN_SERVER=http://localhost:3080                                          # [optional]
SESSION_EXPIRY=604800000                                                     # [optional] ms — default 7 days
REFRESH_TOKEN_EXPIRY=2592000000                                              # [optional] ms — default 30 days
ALLOW_REGISTRATION=true                                                      # [optional]
ALLOW_SOCIAL_LOGIN=true                                                      # [optional]
ALLOW_SOCIAL_REGISTRATION=true                                               # [optional]
ENABLE_OAUTH_SIGNUP=true                                                     # [optional] Open WebUI — allow account creation via Google OAuth

# --- Open WebUI auth + pipeline connection ---
WEBUI_AUTH=true                                                              # [optional]
OAUTH_PROVIDER_NAME=Google                                                   # [optional] label shown on Open WebUI's OAuth login button
OPENAI_API_BASE_URL=http://openwebui-pipeline:9099                           # [optional] saas profile only — Open WebUI's OpenAI-compatible upstream; points at the bundled pipeline sidecar; leave as-is
PIPELINE_API_KEY=__FILL_RANDOM_32_CHARS__                                     # [optional] saas profile only — openwebui-pipeline auth (generate: openssl rand -hex 16)

# --- Frontend public URLs + realtime origins (only matter once the frontends run) ---
CENTRIFUGO_WS_URL_PUBLIC=ws://localhost:8000/connection/websocket             # [optional] public WSS URL the Chrome extension + PWA connect to
# Browser origins Centrifugo accepts a WebSocket handshake FROM. A browser sends `Origin`
# on the handshake and Centrifugo refuses anything unlisted — the socket never opens, so
# realtime dies silently while HTTP keeps working. This exact line, missing the web app's
# own origin, cost two days: the extension worked (its origin was listed), messages still
# sent, and the gate passed because it runs under Node, which sends no Origin at all.
# Leave EMPTY to take the compose default, which already covers the extension,
# https://$XBRAIN_BASE_DOMAIN, its subdomains and localhost. Set it only to override.
# [optional] space-separated, e.g. "chrome-extension://* https://app.example.com"
CENTRIFUGO_ALLOWED_ORIGINS=
WEBUI_URL=http://localhost:8080                                               # [optional] Open WebUI's own public base URL
LIBRECHAT_ALLOWED_DOMAINS=localhost                                           # [optional] domains allowed to complete LibreChat registration
BRIDGE_BASE_URL=http://session-bridge:8105/v1                                 # [optional] internal URL LibreChat's custom endpoint config points at for the Pro/Max bridge
APP_TEAMS_URL=http://localhost:8000/account/teams/                            # [optional] linked from LibreChat's "manage teams" UI
# [optional] build-time base URL baked into LibreChat's onboarding.js — leave blank for local dev
LIBRECHAT_MEMORY_API_BASE=

# --- Collaborative board (opt-in `board` profile — only matter with COMPOSE_PROFILES=board) ---
BOARD_PUBLIC_BASE_URL=http://board.localhost      # [optional] public base URL of the board SPA (used to build the open-board link)
BOARD_WS_URL_PUBLIC=ws://board.localhost/collab   # [optional] public Yjs WebSocket URL
BOARD_TOKEN_TTL_S=3600                            # [optional] board access-token lifetime, seconds
BOARD_MAX_DOC_BYTES=16777216                      # [optional] hard cap on a stored board document (16 MB)

# --- Web push (PWA notifications, Phase 27 PUSH-01) ---
# Leave the keypair EMPTY and push is simply off: /v1/push/config answers
# {"enabled": false}, the client never asks for notification permission, and nothing is
# ever sent. An OSS install boots fine with this whole block untouched.
#
# To turn push ON, mint a VAPID P-256 keypair (the private half is a SERVER SECRET —
# put it in this deployment's .env only; never commit it, never paste it into a client):
#
#   docker exec xbrain-memory-api python -c "
#   import base64
#   from cryptography.hazmat.primitives import serialization
#   from cryptography.hazmat.primitives.asymmetric import ec
#   b64 = lambda b: base64.urlsafe_b64encode(b).rstrip(b'=').decode()
#   k = ec.generate_private_key(ec.SECP256R1())
#   print('VAPID_PUBLIC_KEY=' + b64(k.public_key().public_bytes(
#       serialization.Encoding.X962, serialization.PublicFormat.UncompressedPoint)))
#   print('VAPID_PRIVATE_KEY=' + b64(k.private_numbers().private_value.to_bytes(32,'big')))
#   "
#
# The public value is 87 base64url chars (65 bytes, first byte 0x04); the private value is
# 43 chars (32 bytes). Rotating the pair invalidates every stored subscription — clients
# re-subscribe on their next visit because the key is served by an endpoint, not baked in.
PUSH_ENABLED=true                                 # [optional] master kill-switch for the send path
VAPID_PUBLIC_KEY=                                 # [optional] public P-256 point, base64url — served to browsers; empty = push disabled
VAPID_PRIVATE_KEY=__FILL_VAPID_PRIVATE_KEY__      # [optional] SERVER SECRET, base64url — never commit, never returned by any endpoint
VAPID_SUBJECT=mailto:admin@example.com            # [optional] contact `sub` claim push services require; use a real address you monitor
PUSH_TTL_S=86400                                  # [optional] seconds a push service may hold an undelivered message
PUSH_PREVIEW_CHARS=120                            # [optional] hard cap on the notification body preview
PUSH_SUBSCRIBE_RATE_LIMIT=20/minute               # [optional] per-user budget on /v1/push/subscribe

# --- Transcript import (Claude Code / ChatGPT conversations into the team brain) ---
# All optional with working defaults — a zero-key OSS install imports out of the box.
#
# MAX_BYTES is a HARD cap enforced by streaming the request body and aborting mid-stream,
# so a 200 MB upload is never materialised in a 4 GB VM. A full ChatGPT export of a heavy
# account exceeds it; the error names the limit and says to import one conversation instead.
TRANSCRIPT_IMPORT_MAX_BYTES=26214400              # [optional] 25 MiB request ceiling
# Fan-out ceilings: a crafted file must not turn one request into a million background
# upserts, and a real export must not silently drown the team's brain.
TRANSCRIPT_IMPORT_MAX_CONVERSATIONS=500           # [optional] conversations accepted per request
TRANSCRIPT_IMPORT_MAX_TURNS=5000                  # [optional] turns accepted per request
# Turns ingested concurrently. Each may call the Haiku relevance classifier, so this is the
# knob that stops an import saturating that budget (and the event loop) in one burst.
TRANSCRIPT_IMPORT_CONCURRENCY=4                   # [optional] parallel turn ingests

# --- Bridge / pipeline team-scope defaults ---
BRIDGE_DEFAULT_TEAM_SCOPE=default                                            # [optional] neutral fallback team scope — a self-hoster may leave this as-is
BRIDGE_BACKFILL_FROM=startup                                                 # [optional]
PIPELINE_DEFAULT_TEAM_SCOPE=default                                         # [optional] neutral fallback, same as above (D-04)
SESSION_BRIDGE_LOG_LEVEL=info                                                # [optional] log verbosity for the session-bridge container (info|warning|error|debug)

# --- Langfuse self-hosted (LLM observability — runs under the integrations profile, ~3-4GB RAM) ---
# DB lives inside the same Postgres instance, as a separate logical database.
# Run once: docker exec xbrain-postgres psql -U xbrain -c "CREATE DATABASE langfuse OWNER xbrain;"
LANGFUSE_POSTGRES_URL=postgresql://xbrain:__FILL_POSTGRES_PASSWORD__@postgres:5432/langfuse  # [optional]
LANGFUSE_HOST=https://lang.example.com                                        # [optional]
LANGFUSE_CLICKHOUSE_PASSWORD=__FILL_RANDOM_32_CHARS__                         # [optional] generate: openssl rand -base64 32
LANGFUSE_REDIS_PASSWORD=__FILL_RANDOM_32_CHARS__                              # [optional] generate: openssl rand -base64 32
LANGFUSE_SALT=__FILL_RANDOM_64_CHARS__                                        # [optional] generate: openssl rand -base64 64
LANGFUSE_NEXTAUTH_SECRET=__FILL_RANDOM_64_CHARS__                             # [optional] generate: openssl rand -base64 64
LANGFUSE_ENCRYPTION_KEY=__FILL_RANDOM_64_HEX__                                # [optional] generate: openssl rand -hex 32
LANGFUSE_INIT_USER_EMAIL=admin@example.com                                    # [optional] bootstrap admin — used only on first boot
LANGFUSE_INIT_USER_NAME=xbrain admin                                          # [optional]
LANGFUSE_INIT_USER_PASSWORD=__FILL_RANDOM_32_CHARS__                          # [optional]
LANGFUSE_INIT_PROJECT_NAME=xbrain                                             # [optional]
LANGFUSE_PUBLIC_KEY=__SET_AFTER_FIRST_LOGIN__                                 # [optional] filled after first login at $LANGFUSE_HOST -> Settings -> API Keys
LANGFUSE_SECRET_KEY=__SET_AFTER_FIRST_LOGIN__                                 # [optional]

# --- mcp-deck bucket (integrations profile — deck rendering storage) ---
MINIO_DECKS_BUCKET=xbrain-decks                                              # [optional]

# --- Backups (local + GCS — ops profile) ---
# [optional]
GCS_BACKUP_BUCKET=
# [optional] path to a mounted key file — leave blank to use the VM's attached service account instead
GCS_SERVICE_ACCOUNT_KEY=
BACKUP_RETENTION_DAILY=7                                                      # [optional]

# --- VM deploy (used by the Makefile, not by any container) ---
VM_HOST=__VM_HOST__                                                          # [optional]
VM_USER=user                                                                 # [optional]
SSH_KEY=~/.ssh/xbrain_key                                                    # [optional]
