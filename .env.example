# ==========================================================
# xbrain Phase 1 — environment template
# Copy to .env and fill in values. Never commit .env.
# ==========================================================

# --- Domain / network ---
# Pas de domaine en Phase 1 — on utilise l'IP brute.
# Ces vars seront utilisées par LibreChat et nginx.
DOMAIN_URL=http://__VM_HOST__
DOMAIN_CLIENT=http://__VM_HOST__
DOMAIN_SERVER=http://__VM_HOST__

# --- Google OAuth (1 client unique partagé entre les 2 frontends) ---
GOOGLE_CLIENT_ID=__FILL__
GOOGLE_CLIENT_SECRET=__FILL__
GOOGLE_CALLBACK_URL=http://__VM_HOST__/oauth/google/callback
GOOGLE_REDIRECT_URI=http://__VM_HOST__/openwebui/oauth/google/callback

# --- Provider API keys (LibreChat & memory-api) ---
ANTHROPIC_API_KEY=__FILL__
OPENAI_API_KEY=__FILL__
XAI_API_KEY=__FILL__

# --- PostgreSQL (memory-api) ---
POSTGRES_USER=xbrain
POSTGRES_PASSWORD=__FILL_RANDOM_32_CHARS__
POSTGRES_DB=xbrain
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://xbrain:__FILL_RANDOM_32_CHARS__@postgres:5432/xbrain

# --- Qdrant (memory-api) ---
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=

# --- memory-api ---
MEMORY_API_URL=http://memory-api:8000
MEMORY_API_PUBLIC_BASE=http://__VM_HOST__/api
JWT_ALGORITHM=HS256
BRIDGE_SHARED_SECRET=__FILL_RANDOM_64_CHARS__
LOG_LEVEL=INFO

# --- Centrifugo (quick task 260512-tcr — team chat realtime) ---
# HMAC secret for client JWT tokens (issued by memory-api to authenticate WS connections).
# Generate: openssl rand -hex 32
CENTRIFUGO_TOKEN_HMAC_SECRET=__FILL_RANDOM_64_HEX__
# API key for server-side publish/presence/history calls from memory-api + agent-runtime.
# Generate: openssl rand -hex 32
CENTRIFUGO_API_KEY=__FILL_RANDOM_64_HEX__
# Public WS URL (consumed by extension + future PWA)
CENTRIFUGO_WS_URL_PUBLIC=wss://centrifugo.grooveos.app/connection/websocket
# Internal HTTP URL for server-side publish calls (memory-api → centrifugo)
CENTRIFUGO_HTTP_URL_INTERNAL=http://centrifugo:8000

# --- LibreChat ---
APP_TITLE=The shared brain for synthetic teams.
HOST=0.0.0.0
PORT=3080
MONGO_URI=mongodb://librechat-mongo:27017/LibreChat
MEILI_HOST=http://librechat-meili:7700
MEILI_MASTER_KEY=__FILL_RANDOM_32_CHARS__
ALLOW_REGISTRATION=true
ALLOW_SOCIAL_LOGIN=true
ALLOW_SOCIAL_REGISTRATION=true
SESSION_EXPIRY=604800000
REFRESH_TOKEN_EXPIRY=2592000000
JWT_SECRET=__FILL_RANDOM_64_CHARS__
JWT_REFRESH_SECRET=__FILL_RANDOM_64_CHARS__
CREDS_KEY=__FILL_RANDOM_64_HEX__
CREDS_IV=__FILL_RANDOM_32_HEX__

# --- Open WebUI ---
WEBUI_AUTH=true
ENABLE_OAUTH_SIGNUP=true
OAUTH_PROVIDER_NAME=Google
OAUTH_GOOGLE_CLIENT_ID=__FILL__
OAUTH_GOOGLE_CLIENT_SECRET=__FILL__
OPENWEBUI_SECRET_KEY=__FILL_RANDOM_64_CHARS__
OPENAI_API_BASE_URL=http://openwebui-pipeline:9099

# --- librechat-bridge ---
LIBRECHAT_MONGO_URI=mongodb://librechat-mongo:27017/LibreChat?replicaSet=rs0
BRIDGE_BACKFILL_FROM=startup
BRIDGE_DEFAULT_TEAM_SCOPE=default

# --- openwebui-pipeline ---
PIPELINE_API_KEY=__FILL_RANDOM_32_CHARS__
PIPELINE_DEFAULT_TEAM_SCOPE=default

# --- Langfuse self-hosted (Plan 02-09) ---
# DB lives inside the same Postgres instance, separate logical database.
# Run once: docker exec xbrain-postgres psql -U xbrain -c "CREATE DATABASE langfuse OWNER xbrain;"
LANGFUSE_POSTGRES_URL=postgresql://xbrain:__FILL_POSTGRES_PASSWORD__@postgres:5432/langfuse
LANGFUSE_HOST=https://lang.grooveos.app
# Generate with: openssl rand -base64 32
LANGFUSE_CLICKHOUSE_PASSWORD=__FILL_RANDOM_32_CHARS__
LANGFUSE_REDIS_PASSWORD=__FILL_RANDOM_32_CHARS__
# Generate with: openssl rand -base64 64
LANGFUSE_SALT=__FILL_RANDOM_64_CHARS__
LANGFUSE_NEXTAUTH_SECRET=__FILL_RANDOM_64_CHARS__
# Generate with: openssl rand -hex 32
LANGFUSE_ENCRYPTION_KEY=__FILL_RANDOM_64_HEX__
# Bootstrap admin (used only on first boot)
LANGFUSE_INIT_USER_EMAIL=team@grooveos.app
LANGFUSE_INIT_USER_NAME=xbrain admin
LANGFUSE_INIT_PROJECT_NAME=xbrain
# Filled AFTER first login at $LANGFUSE_HOST → Settings → API Keys
LANGFUSE_PUBLIC_KEY=__SET_AFTER_FIRST_LOGIN__
LANGFUSE_SECRET_KEY=__SET_AFTER_FIRST_LOGIN__

# === Neo4j Community (plan 03-01) — graph store ===
# Utilisé par memory-api (outbox worker + graph endpoints) via AsyncGraphDatabase
# NEO4J_URI: bolt:// pour le driver Python neo4j (port 7687, réseau interne)
# Password: openssl rand -base64 24  (éviter / et + qui cassent les URLs)
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=__FILL_RANDOM_32__

# === Drive admin OAuth (plan 03-10) ===
# External URL for the memory-api (used to build the OAuth redirect_uri)
MEMORY_API_EXTERNAL_URL=https://chat.grooveos.app
# Fernet encryption key for storing OAuth credentials at rest
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
OAUTH_CREDENTIALS_ENCRYPTION_KEY=__FILL_FERNET_KEY__
# GOOGLE_CLIENT_SECRET is the same credential used for Phase 1 Google OAuth — already set above

# === Calendar credentials for mcp-calendar sidecar (plan 03-09) ===
# Obtain these after Google OAuth consent for calendar.readonly scope
# See docs/google-oauth-scope-upgrade.md for setup steps
GOOGLE_CALENDAR_ACCESS_TOKEN=__FILL_AFTER_OAUTH__
GOOGLE_CALENDAR_REFRESH_TOKEN=__FILL_AFTER_OAUTH__

# === Drive credentials for mcp-drive-read sidecar (plan 03-08) ===
# Obtain these after Google OAuth consent for drive.readonly + drive.file scopes
# See docs/google-oauth-scope-upgrade.md for incremental auth setup
# GOOGLE_CLIENT_SECRET is already set above (shared Google OAuth client)
GOOGLE_DRIVE_ACCESS_TOKEN=__FILL_AFTER_OAUTH__
GOOGLE_DRIVE_REFRESH_TOKEN=__FILL_AFTER_OAUTH__

# === MCP Gateway (plan 03-06) ===
# Utilise DATABASE_URL, BRIDGE_SHARED_SECRET, GOOGLE_CLIENT_ID existants — pas de nouvelles vars.
# Port interne : 8080 (xbrain_net uniquement). Pas exposé sur l'hôte sauf accès direct requis.

# === MCP Tool Registration (plan 03-12) ===
# After deploying Phase 3, run: bash infrastructure/scripts/register-mcp-tools.sh
# Requires BRIDGE_SHARED_SECRET to be set (already in .env from Phase 1).
# MCP_GATEWAY_URL defaults to http://localhost:8080 (host VM access via docker exec).
# Inside Docker network, sidecars reach the gateway at http://mcp-gateway:8080.
MCP_GATEWAY_URL=http://mcp-gateway:8080

# === Drive Sync service (plan 03-11) ===
# Poll interval in seconds (default 5 minutes = 300s).
# Set lower for dev/testing, keep at 300 for production to respect Drive API quotas.
DRIVE_SYNC_POLL_INTERVAL=300

# --- Backups (Phase 1 = local + GCS) ---
GCS_BACKUP_BUCKET=xbrain-backups-prod
GCS_SERVICE_ACCOUNT_KEY=/secrets/gcs-backup-sa.json
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4

# --- VM (utilisé par Makefile, pas par les containers) ---
VM_HOST=__VM_HOST__
VM_USER=user
SSH_KEY=~/.ssh/xbrain_key

# === Phase 5 — Plateforme Projets Équipe ===

# === Phase 5 — LibreChat GitHub OAuth (UNCHANGED — separate concern) ===
# Used ONLY by apps/memory-api/app/routes/me_github.py for the LibreChat
# account-linking flow. The OAuth App `xbrain LibreChat` (Client ID
# Ov23li0XHV3NL8Git7Dk) is OUT OF SCOPE for Phase 12 — see 12-CONTEXT.md.
# Homepage URL: https://chat.grooveos.app
# Callback URL: https://chat.grooveos.app/oauth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=/oauth/github/callback

# === Phase 12 — GitHub App (NEW — REPLACES OAuth App `xbrain`) ===
# The GitHub App handles ALL xbrain auth (web + chrome extension). Generated
# by registering the App on the mrboups account; private key downloaded once
# and base64-encoded to a single line:
#   openssl base64 -A -in xbrain.pem
# See docs/auth.html (added by Plan 12-09) for the full operator runbook.
GITHUB_APP_ID=
GITHUB_APP_SLUG=xbrain
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY_B64=
GITHUB_APP_WEBHOOK_SECRET=

# === Phase 5 — GitHub org config (still used in v1) ===
GITHUB_ORG=your-github-org

# GITHUB_API_PAT — REMOVED (Phase 12 Plan 12-04). Org membership is now
# checked via installation tokens minted from the xbrain GitHub App. The
# /etc/.env on the VM should also drop GITHUB_API_PAT and the legacy
# GITHUB_ORG_PAT alias — both are now ignored. GITHUB_ORG_NAME was also a
# duplicate of GITHUB_ORG; use GITHUB_ORG (above).

# graphiti-service — temporal fact extraction (plan 05-01)
# OPENAI_API_KEY déjà défini plus haut (section agent-runtime) — réutilisé par graphiti-service
GRAPHITI_LLM_MODEL=claude-haiku-4-5-20251001
GRAPHITI_SERVICE_URL=http://graphiti-service:8300

# GCP / Firebase — pipeline deploy GitOps (plan 05-03)
# GCP Project Number: gcloud projects describe xbrain-495115 --format='value(projectNumber)'
GCP_PROJECT_NUMBER=

# ─── Phase 7 — CRM + Granola + Tasks ────────────────────────────────

# Granola REST API polling
# API key registered per team via POST /v1/admin/granola-integration (encrypted Fernet at rest)
# Personal API keys require Granola Business or Enterprise plan
GRANOLA_API_BASE=https://api.granola.ai
GRANOLA_POLL_INTERVAL_SECONDS=300

# Anthropic Claude — used by granola-sync (note extraction) and memory-api (auto-extract contacts/tasks)
# Note: ANTHROPIC_API_KEY is already set above (shared with LibreChat + memory-api)
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Fernet key for encrypting Granola API keys at rest (granola_integrations.api_key_enc)
# If empty, falls back to OAUTH_CREDENTIALS_ENCRYPTION_KEY (drive-sync key)
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# Resend — waitlist email proxy (grooveos.app landing page)
RESEND_API_KEY=
WAITLIST_TO=team@grooveos.app
WAITLIST_FROM=GrooveOS <waitlist@grooveos.app>

# SMTP for task assignment notifications (D6)
# When SMTP_HOST is empty, email notifications are skipped silently (fail-soft)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@grooveos.app
SMTP_TLS=true

# ─── Phase 8 — GitHub repos proxy ────────────────────────────────────────────

# Internal Docker network URL to LibreChat. Used by memory-api /v1/github/repos
# to proxy the caller's LibreChat session JWT to /api/xbrain/github-repos.
# Without this, GET /v1/github/repos returns 503.
LIBRECHAT_INTERNAL_URL=http://librechat:3080

# ─── Phase 8 — Granola per-user + Universal extraction + Platform agents ────

# librechat-bridge — opt-in contact extraction from LibreChat messages (Phase 8 D3)
# When CONTACT_EXTRACTION=true, librechat-bridge calls Claude haiku on each new
# message (user OR assistant) and upserts mentioned persons into /v1/crm/contacts.
# Default false — explicit opt-in to avoid unexpected Anthropic spend.
# ANTHROPIC_API_KEY (already set above) is required when CONTACT_EXTRACTION=true.
CONTACT_EXTRACTION=false
ANTHROPIC_CONTACT_MODEL=claude-3-5-haiku-20241022

# Granola API access for per-user polling (Phase 8 D1)
# Each user submits their personal Granola API key via the LibreChat onboarding
# overlay → POST /v1/me/granola-key. The key is Fernet-encrypted at rest in
# granola_user_connections.api_key_enc using FERNET_KEY (already set in Phase 7).
# No new env var required for the per-user loop — granola-sync reads from the DB.

# Note: GitHub OAuth scope `repo` (via Phase 5 GITHUB_CLIENT_ID/SECRET) is
# REQUIRED so /api/xbrain/github-repos (LibreChat) can list user's private repos.

# ─── Phase 9 — Session Bridge (Pro/Max routing via Chrome extension) ─────────

# Log verbosity for the session-bridge container (info|warning|error|debug).
SESSION_BRIDGE_LOG_LEVEL=info

# BRIDGE_SHARED_SECRET is already defined above (Phase 1 memory-api section).
# session-bridge reuses it to sign HS256 bridge JWTs with an acting_user_sub
# claim when calling memory-api /v1/me/external-sessions (Phase 9 register
# handshake). Rotate both ends together if you ever change it. After rotation,
# users must paste a fresh xbt_ token in LibreChat's "Claude (mon abonnement)"
# endpoint (see Pitfall 6 in 09-RESEARCH.md and docs/sessions.html).

# (Optional) xbt_ token used by verify-phase9.sh test 5 to exercise the WS
# upgrade end-to-end. Leave blank — test 5 will be SKIPPED (not failed).
# NEVER commit a real token here.
# VERIFY_XBT_TOKEN=xbt_...

# (Optional) Postgres credentials overrides for verify-phase9.sh test 6.
# Defaults to xbrain/xbrain (matches POSTGRES_USER / POSTGRES_DB above).
# PG_USER=xbrain
# PG_DB=xbrain

# ─── Phase 10 — GitHub-primary auth + org-driven team membership ─────────────
#
# No new env vars introduced in Phase 10. Inputs reused:
#   - GITHUB_CLIENT_ID / GITHUB_CLIENT_SECRET (Phase 5) — shared with LibreChat
#     OAuth. memory-api's /v1/auth/github/signin exchanges OAuth codes against
#     the same app. The OAuth app's authorized callback URLs MUST include
#     https://grooveos.app/account/teams/ for the app-site flow.
#   - SMTP_HOST / SMTP_PORT / SMTP_USERNAME / SMTP_PASSWORD / SMTP_FROM (Phase 7) —
#     used by send_member_autojoined_email. Fail-soft when SMTP_HOST is empty
#     (auto-grant still fires; admins just don't get the email).
#
# Optional overrides for verify-phase10.sh:
#   MEMORY_API_BASE  default https://api.grooveos.app
#   APP_SITE_BASE    default https://grooveos.app
#   PYTEST_CMD       default "pytest"  (or "docker exec xbrain-memory-api pytest")
#   PYTEST_CWD       default "apps/memory-api"
