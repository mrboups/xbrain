# ==========================================================
# xbrain — environment template
# ==========================================================
# Copy to `.env`, fill every `[required]` var, leave the rest — they have
# safe defaults. Run `make env-check` to verify before deploying.
# Never commit `.env`.
# ==========================================================

# === Required — minimal boot ===

# --- PostgreSQL (memory-api, LibreChat's RAG backend, librechat-bridge, backups) ---
POSTGRES_USER=xbrain                                                          # [optional] role name
POSTGRES_PASSWORD=__FILL_RANDOM_32_CHARS__                                    # [required] keep in sync with the password embedded in DATABASE_URL below
POSTGRES_DB=xbrain                                                            # [optional] database name
POSTGRES_HOST=postgres                                                        # [optional] internal Docker service name — leave as-is
POSTGRES_PORT=5432                                                            # [optional]
DATABASE_URL=postgresql+asyncpg://xbrain:__FILL_RANDOM_32_CHARS__@postgres:5432/xbrain  # [required] memory-api's async SQLAlchemy DSN

# --- Cross-service auth ---
BRIDGE_SHARED_SECRET=__FILL_RANDOM_64_CHARS__                                 # [required] HMAC secret memory-api uses to sign/verify internal service JWTs (librechat-bridge, openwebui-pipeline, agent-runtime, session-bridge, mcp-brain)
JWT_ALGORITHM=HS256                                                           # [required] algorithm for the secret above
LOG_LEVEL=INFO                                                                # [optional] shared log verbosity across memory-api and every Python sidecar

# --- Qdrant (memory-api vector search) ---
QDRANT_URL=http://qdrant:6333                                                 # [required]
QDRANT_API_KEY=                                                               # [optional] leave blank for the bundled unauthenticated Qdrant container

# --- Realtime team chat (Centrifugo) — generate both with: openssl rand -hex 32 ---
CENTRIFUGO_TOKEN_HMAC_SECRET=__FILL_RANDOM_64_HEX__                           # [required] signs client WS auth tokens issued by memory-api
CENTRIFUGO_API_KEY=__FILL_RANDOM_64_HEX__                                     # [required] server-side publish/presence/history calls
CENTRIFUGO_HTTP_URL_INTERNAL=http://centrifugo:8000                          # [optional] internal Docker service name — leave as-is

# --- LibreChat search index + Open WebUI session signing ---
MEILI_MASTER_KEY=__FILL_RANDOM_32_CHARS__                                     # [required]
OPENWEBUI_SECRET_KEY=__FILL_RANDOM_64_CHARS__                                 # [required]

# --- LibreChat's own secrets — generate: openssl rand -hex 32 (CREDS_IV: openssl rand -hex 16) ---
JWT_SECRET=__FILL_RANDOM_64_CHARS__                                           # [required]
JWT_REFRESH_SECRET=__FILL_RANDOM_64_CHARS__                                   # [required]
CREDS_KEY=__FILL_RANDOM_64_HEX__                                              # [required] encrypts stored user credentials — must be 32 bytes hex
CREDS_IV=__FILL_RANDOM_32_HEX__                                               # [required] must be 16 bytes hex

# --- LibreChat's Mongo + search connections (internal Docker service names — leave as-is) ---
MONGO_URI=mongodb://librechat-mongo:27017/LibreChat                          # [required]
MEILI_HOST=http://librechat-meili:7700                                       # [required]
LIBRECHAT_MONGO_URI=mongodb://librechat-mongo:27017/LibreChat?replicaSet=rs0  # [required] librechat-bridge's change-stream connection — needs the replicaSet query param

# --- LibreChat's own internal session/domain behavior (SEPARATE from XBRAIN_BASE_DOMAIN
#     below — these are consumed directly by the LibreChat container's own cookie/CORS
#     handling, not the nginx ingress) ---
APP_TITLE=xbrain                                                             # [optional] displayed in the LibreChat UI
DOMAIN_CLIENT=http://localhost:3080                                          # [optional] set to your real chat.<domain> for a deploy
DOMAIN_SERVER=http://localhost:3080                                          # [optional]
SESSION_EXPIRY=604800000                                                     # [optional] ms — default 7 days
REFRESH_TOKEN_EXPIRY=2592000000                                              # [optional] ms — default 30 days
ALLOW_REGISTRATION=true                                                      # [optional]
ALLOW_SOCIAL_LOGIN=true                                                      # [optional]
ALLOW_SOCIAL_REGISTRATION=true                                               # [optional]
ENABLE_OAUTH_SIGNUP=true                                                     # [optional] Open WebUI — allow account creation via Google OAuth

# --- Cross-service memory-api URL (internal Docker service name — leave as-is) ---
MEMORY_API_URL=http://memory-api:8000                                        # [required] used by librechat-bridge, openwebui-pipeline, LibreChat, and every sidecar

# --- Open WebUI auth + pipeline connection ---
WEBUI_AUTH=true                                                              # [optional]
OAUTH_PROVIDER_NAME=Google                                                   # [optional] label shown on Open WebUI's OAuth login button
OPENAI_API_BASE_URL=http://openwebui-pipeline:9099                           # [required] Open WebUI's OpenAI-compatible upstream — points at the bundled pipeline sidecar; leave as-is

# --- openwebui-pipeline auth — generate: openssl rand -hex 16 ---
PIPELINE_API_KEY=__FILL_RANDOM_32_CHARS__                                     # [required]

# === LLM provider keys (at least one required) ===
ANTHROPIC_API_KEY=__FILL__                                                    # [required] powers Claude in LibreChat, plus memory-api's relevance filter/extraction features
OPENAI_API_KEY=__FILL__                                                       # [optional] GPT in LibreChat + text-embedding-3-small
XAI_API_KEY=__FILL__                                                          # [optional] Grok in LibreChat

# === Domain / public URLs (neutral defaults ship working; set these for a real deploy) ===

# THE domain knob: one var repoints every nginx vhost
# (chat./api./mcp./adm./lang./bridge./centrifugo./projects.<domain>).
XBRAIN_BASE_DOMAIN=localhost                                                  # [required] default: localhost (local dev). Set to your real domain to deploy.

# Fallback target for the projects.<domain> vhost, which normally has DNS pointed straight at
# your dashboard host and is never hit. Leave EMPTY and that vhost returns 404 — it must never
# redirect your visitors to somebody else's site. Scheme + host, no trailing slash.
# Must keep the XBRAIN_ prefix: nginx only substitutes vars matching NGINX_ENVSUBST_FILTER=^XBRAIN_.
XBRAIN_PROJECTS_FALLBACK_URL=                                                 # [optional] e.g. https://dashboard.yourdomain.com — empty = 404

MEMORY_API_EXTERNAL_URL=http://localhost:8000                                 # [optional] external base URL of memory-api — used to build OAuth redirect_uris
APP_PUBLIC_URL=http://localhost:8000                                          # [optional] used in outbound email links (invite/notification emails)
CENTRIFUGO_WS_URL_PUBLIC=ws://localhost:8000/connection/websocket             # [optional] public WSS URL the Chrome extension + PWA connect to
SMTP_FROM=noreply@example.com                                                 # [optional] "From" address for task-notification emails — SMTP_HOST empty = emails skipped (fail-soft)
WEBUI_URL=http://localhost:8080                                               # [optional] Open WebUI's own public base URL
LIBRECHAT_ALLOWED_DOMAINS=localhost                                           # [optional] domains allowed to complete LibreChat registration
BRIDGE_BASE_URL=http://session-bridge:8105/v1                                 # [optional] internal URL LibreChat's custom endpoint config points at for the Pro/Max bridge
APP_TEAMS_URL=http://localhost:8000/account/teams/                            # [optional] linked from LibreChat's "manage teams" UI
LIBRECHAT_MEMORY_API_BASE=                                                    # [optional] build-time base URL baked into LibreChat's onboarding.js — leave blank for local dev
CENTRIFUGO_ALLOWED_ORIGINS=chrome-extension://* http://localhost:8080         # [optional] space-separated list — Centrifugo WS handshake origin allow-list

# Browser origins allowed to call memory-api. If you serve a web app or a
# browser extension from your own domain, ADD IT HERE or the browser will be
# CORS-blocked. Do NOT set this to `.*` — that lets any site make
# credentialed calls. Default: chrome-extension + localhost.
CORS_ALLOWED_ORIGIN_REGEX=(chrome-extension://.*|http://localhost(:\d+)?)     # [required]

# Comma-separated aliases that summon the agent in team chat, WITHOUT the
# leading '@'. Default: `agent` (so users type `@agent`). Add your own
# alongside it, e.g. `AGENT_MENTION_ALIASES=agent,ai,assistant` — every alias
# in the list works, so keeping `agent` first means `@agent` always resolves.
# A rebrand is a change here, not in code.
# The FIRST alias in the list is also the one the assistant names in its own
# system prompt (LibreChat renders `mention @<first>`), so put the alias you
# want advertised first. Order is cosmetic only: the detector treats the list
# as a set, so every alias resolves regardless of position.
AGENT_MENTION_ALIASES=agent                                                   # [required]

# === OAuth identity — REQUIRED. Empty = memory-api and mcp-brain CRASH AT BOOT (by design) ===
# These have NO default. A misleading default would silently mint tokens
# bound to the wrong resource, so an empty value fails fast at boot instead.
# `make env-check` also refuses to deploy without them.
OAUTH_ISSUER_URL=                                                             # [required] public base URL of THIS deployment's authorization server, e.g. https://api.yourdomain.com
OAUTH_RESOURCE_URL=                                                           # [required] the mcp-brain audience issued tokens are bound to (RFC 8707), e.g. https://mcp.yourdomain.com/mcp

# --- Google OAuth (shared by LibreChat, Open WebUI, memory-api's Drive/Calendar sidecars) ---
GOOGLE_CLIENT_ID=__FILL__                                                     # [required]
GOOGLE_CLIENT_SECRET=__FILL__                                                 # [required]
GOOGLE_CALLBACK_URL=http://localhost:3080/oauth/google/callback               # [optional] LibreChat's OAuth callback path
GOOGLE_REDIRECT_URI=http://localhost:8080/openwebui/oauth/google/callback     # [optional] Open WebUI's OAuth callback path
OAUTH_GOOGLE_CLIENT_ID=__FILL__                                               # [optional] Open WebUI reads its OAuth client under this name — usually the same value as GOOGLE_CLIENT_ID
OAUTH_GOOGLE_CLIENT_SECRET=__FILL__                                           # [optional] same as above, secret half

# === Optional integrations (safe to leave blank — the feature no-ops) ===

# --- GitHub App (repo indexing, org-driven team membership, contents:read) ---
# Register your own GitHub App; download the private key once and base64-encode it:
#   openssl base64 -A -in your-app.pem
GITHUB_APP_ID=                                                                # [optional] numeric App ID
GITHUB_APP_SLUG=xbrain-auth                                                   # [optional] URL slug for the install URL (github.com/apps/<slug>/installations/new)
GITHUB_APP_CLIENT_ID=                                                         # [optional]
GITHUB_APP_CLIENT_SECRET=                                                     # [optional]
GITHUB_APP_PRIVATE_KEY_B64=                                                   # [optional] base64-encoded PEM, single line
GITHUB_APP_WEBHOOK_SECRET=                                                    # [optional] HMAC-SHA256 secret for the installation webhook
GITHUB_FALLBACK_TOKEN=                                                        # [optional] stopgap `repo`-scope PAT used when the App isn't installed on a repo owner — empty = App-only reads

# --- GitHub OAuth App (LibreChat account-linking — separate concern from the GitHub App above) ---
GITHUB_CLIENT_ID=                                                             # [optional]
GITHUB_CLIENT_SECRET=                                                         # [optional]
GITHUB_CALLBACK_URL=/oauth/github/callback                                    # [optional]
GITHUB_ORG=                                                                   # [optional] org used for org-driven team membership checks

# --- GitHub repo-catalog auto-indexer — safe defaults, no .env change required ---
GITHUB_CATALOG_ENABLED=true                                                   # [optional]
GITHUB_CATALOG_CONCURRENCY=5                                                  # [optional] max parallel upserts per backfill batch
GITHUB_CATALOG_README_CHARS=8000                                              # [optional] README input cap before the Haiku summarization call

# --- SMTP (task-assignment + team-invite notifications) — blank = notifications skipped, fail-soft ---
SMTP_HOST=                                                                    # [optional]
SMTP_PORT=587                                                                 # [optional]
SMTP_USER=                                                                    # [optional]
SMTP_PASSWORD=                                                                # [optional]
SMTP_TLS=true                                                                 # [optional]

# --- Waitlist email proxy (landing page signup form) ---
RESEND_API_KEY=                                                               # [optional]
WAITLIST_TO=team@example.com                                                  # [optional]
WAITLIST_FROM=Example <waitlist@example.com>                                  # [optional]

# --- Granola meeting-notes sync (CRM + Tasks extraction) ---
GRANOLA_API_BASE=https://api.granola.ai                                       # [optional]
GRANOLA_POLL_INTERVAL_SECONDS=300                                             # [optional]
ANTHROPIC_MODEL=claude-3-5-haiku-20241022                                     # [optional] note extraction model for granola-sync
FERNET_KEY=                                                                   # [optional] encrypts Granola API keys + Drive OAuth credentials at rest — falls back to OAUTH_CREDENTIALS_ENCRYPTION_KEY when blank. Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
OAUTH_CREDENTIALS_ENCRYPTION_KEY=__FILL_FERNET_KEY__                          # [optional] Fernet key for Drive OAuth credential storage — same generator as above

# --- Contact extraction from chat (opt-in — explicit to avoid unexpected Anthropic spend) ---
CONTACT_EXTRACTION=false                                                      # [optional]
ANTHROPIC_CONTACT_MODEL=claude-haiku-4-5-20251001                             # [optional]

# --- Chat → Brain Ingestion + Retrieval Enrichment ---
RELEVANCE_HAIKU_ENABLED=true                                                  # [optional] Haiku relevance filter before brain upsert; falls back to a ≥15-char heuristic when false/ANTHROPIC_API_KEY absent
RELEVANCE_DAILY_TOKEN_CAP_PER_TEAM=50000                                      # [optional]
RELEVANCE_HAIKU_MODEL=claude-haiku-4-5-20251001                               # [optional]
RELEVANCE_HAIKU_TIMEOUT_S=3.0                                                 # [optional]
BRAIN_INGEST_ENABLED=true                                                     # [optional] kill-switch for LibreChat/Open WebUI → brain ingest and per-turn enrichment
CHAT07_TOP_K=5                                                                # [optional] facts injected into the system context per turn
CHAT07_TRUTH_FILTER_MIN_LEVEL=WORKING                                         # [optional] minimum truth_level for retrieval (>= semantics)

# --- Google Drive + Calendar sidecars (incremental OAuth scopes) ---
GOOGLE_DRIVE_ACCESS_TOKEN=__FILL_AFTER_OAUTH__                                # [optional]
GOOGLE_DRIVE_REFRESH_TOKEN=__FILL_AFTER_OAUTH__                               # [optional]
GOOGLE_CALENDAR_ACCESS_TOKEN=__FILL_AFTER_OAUTH__                             # [optional]
GOOGLE_CALENDAR_REFRESH_TOKEN=__FILL_AFTER_OAUTH__                            # [optional]
DRIVE_SYNC_POLL_INTERVAL=300                                                  # [optional] seconds — keep at 300 in production to respect Drive API quotas

# --- Neo4j (graph store — entity lineage, dependency mapping) ---
# Also reused as-is (no new vars) by the brain-janitor container, which hard-purges
# soft-deleted rows older than a 30-day retention window pinned in docker-compose.yml —
# do not expect a RETENTION_DAYS override here without a schema/contract change.
NEO4J_URI=bolt://neo4j:7687                                                   # [optional]
NEO4J_USER=neo4j                                                              # [optional]
NEO4J_PASSWORD=__FILL_RANDOM_32__                                             # [optional] generate: openssl rand -base64 24 (avoid `/` and `+`, they break URLs)

# --- Temporal fact extraction (graphiti-service) — reuses OPENAI_API_KEY / ANTHROPIC_API_KEY above ---
GRAPHITI_LLM_MODEL=claude-haiku-4-5-20251001                                  # [optional]
GRAPHITI_SERVICE_URL=http://graphiti-service:8300                            # [optional]

# --- MinIO / Qdrant collection overrides used by the Brain Monitor superadmin storage endpoint ---
# Defaults empty -> the storage endpoint fails soft and shows "N/A" per team.
MINIO_URL=                                                                    # [optional]
MINIO_ACCESS_KEY=                                                             # [optional]
MINIO_SECRET_KEY=                                                             # [optional]
MINIO_BUCKET=xbrain-media                                                     # [optional]
QDRANT_COLLECTION=messages                                                    # [optional] Qdrant collection name memory-api actually writes to

# --- Internal service wiring (safe defaults — internal Docker service names) ---
AGENT_RUNTIME_INTERNAL_URL=http://agent-runtime:8200                          # [optional] memory-api → agent-runtime on @mentions (fire-and-forget)
LIBRECHAT_INTERNAL_URL=http://librechat:3080                                  # [optional] memory-api's /v1/github/repos proxy target — 503 without it
MCP_GATEWAY_URL=http://mcp-gateway:8080                                       # [optional] used by infrastructure/scripts/register-mcp-tools.sh
BRIDGE_DEFAULT_TEAM_SCOPE=default                                             # [optional] neutral fallback team scope — a self-hoster may leave this as-is
BRIDGE_BACKFILL_FROM=startup                                                  # [optional]
PIPELINE_DEFAULT_TEAM_SCOPE=default                                           # [optional] neutral fallback, same as above (D-04)
SESSION_BRIDGE_LOG_LEVEL=info                                                 # [optional] log verbosity for the session-bridge container (info|warning|error|debug)

# --- GCP Cloud Run CI deploy (only relevant if you use the bundled GitHub Actions template) ---
GCP_PROJECT_NUMBER=                                                           # [optional]

# === SaaS-only / not part of OSS-light ===

# --- Langfuse self-hosted (LLM observability — optional, ~3-4GB RAM) ---
# DB lives inside the same Postgres instance, as a separate logical database.
# Run once: docker exec xbrain-postgres psql -U xbrain -c "CREATE DATABASE langfuse OWNER xbrain;"
LANGFUSE_POSTGRES_URL=postgresql://xbrain:__FILL_POSTGRES_PASSWORD__@postgres:5432/langfuse  # [optional]
LANGFUSE_HOST=https://lang.example.com                                        # [optional]
LANGFUSE_CLICKHOUSE_PASSWORD=__FILL_RANDOM_32_CHARS__                         # [optional] generate: openssl rand -base64 32
LANGFUSE_REDIS_PASSWORD=__FILL_RANDOM_32_CHARS__                              # [optional] generate: openssl rand -base64 32
LANGFUSE_SALT=__FILL_RANDOM_64_CHARS__                                        # [optional] generate: openssl rand -base64 64
LANGFUSE_NEXTAUTH_SECRET=__FILL_RANDOM_64_CHARS__                             # [optional] generate: openssl rand -base64 64
LANGFUSE_ENCRYPTION_KEY=__FILL_RANDOM_64_HEX__                                # [optional] generate: openssl rand -hex 32
LANGFUSE_INIT_USER_EMAIL=admin@example.com                                    # [optional] bootstrap admin — used only on first boot
LANGFUSE_INIT_USER_NAME=xbrain admin                                          # [optional]
LANGFUSE_INIT_USER_PASSWORD=__FILL_RANDOM_32_CHARS__                          # [optional]
LANGFUSE_INIT_PROJECT_NAME=xbrain                                             # [optional]
LANGFUSE_PUBLIC_KEY=__SET_AFTER_FIRST_LOGIN__                                 # [optional] filled after first login at $LANGFUSE_HOST → Settings → API Keys
LANGFUSE_SECRET_KEY=__SET_AFTER_FIRST_LOGIN__                                 # [optional]

# --- MinIO (bundled S3-compatible storage — backs Langfuse media uploads + mcp-deck) ---
MINIO_ROOT_USER=minio                                                        # [optional]
MINIO_ROOT_PASSWORD=__FILL_RANDOM_32_CHARS__                                  # [optional]
MINIO_ENDPOINT=langfuse-minio:9000                                           # [optional] internal Docker service name — leave as-is
MINIO_DECKS_BUCKET=xbrain-decks                                              # [optional]

# --- Backups (local + GCS) ---
GCS_BACKUP_BUCKET=                                                            # [optional]
GCS_SERVICE_ACCOUNT_KEY=                                                      # [optional] path to a mounted key file — leave blank to use the VM's attached service account instead
BACKUP_RETENTION_DAILY=7                                                      # [optional]

# --- VM deploy (used by the Makefile, not by any container) ---
VM_HOST=__VM_HOST__                                                           # [optional]
VM_USER=user                                                                  # [optional]
SSH_KEY=~/.ssh/xbrain_key                                                     # [optional]
